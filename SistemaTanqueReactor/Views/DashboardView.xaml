<UserControl x:Class="SistemaTanqueReactor.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:fa="http://schemas.awesome.incremented/wpf/xaml/fontawesome.sharp"
             Background="#0C0E14">

    <UserControl.Resources>
        <!-- Animación neón: pulso de opacidad (equivalente a CSS neon glow) -->
        <Storyboard x:Key="NeonPulse" RepeatBehavior="Forever">
            <DoubleAnimation Storyboard.TargetProperty="Opacity"
                             From="0.55" To="1.0" Duration="0:0:1.2"
                             AutoReverse="True">
                <DoubleAnimation.EasingFunction>
                    <SineEase EasingMode="EaseInOut"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
        </Storyboard>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel>

            <Grid Margin="0,0,0,24">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <fa:IconImage Icon="ChartLine" Foreground="#00E5FF" Width="16" Height="16" VerticalAlignment="Center"/>
                        <TextBlock Text="DASHBOARD" FontSize="11" FontWeight="Bold" Foreground="#00E5FF" Margin="8,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                    <TextBlock Text="Producción en vivo" FontSize="24" FontWeight="Bold" Foreground="#F1F5F9" Margin="0,6,0,0"/>
                </StackPanel>
                <Button HorizontalAlignment="Right" VerticalAlignment="Center"
                        Command="{Binding RefrescarCommand}" Style="{StaticResource PrimaryButton}"
                        Content="REFRESH" Padding="16,0"/>
            </Grid>

            <UniformGrid Columns="4" Margin="0,0,0,20">

                <Border x:Name="Kpi1" Background="#1A1D27" CornerRadius="8" Margin="0,0,8,0" BorderBrush="#00E5FF" BorderThickness="1">
                    <Grid>
                        <Border x:Name="Glow1" Width="3" HorizontalAlignment="Left" Background="#00E5FF" CornerRadius="8,0,0,8"/>
                        <StackPanel Margin="18,16">
                            <StackPanel Orientation="Horizontal">
                                <fa:IconImage Icon="ClipboardList" Foreground="#00E5FF" Width="14" Height="14"/>
                                <TextBlock Text="REGISTROS" FontSize="10" FontWeight="Bold" Foreground="#8B92A5" Margin="8,0,0,0"/>
                            </StackPanel>
                            <TextBlock Text="{Binding RegistrosHoy}" FontSize="36" FontWeight="Bold" Foreground="#00E5FF" Margin="0,8,0,0"/>
                            <TextBlock Text="hoy" FontSize="11" Foreground="#5A6275"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <Border Background="#1A1D27" CornerRadius="8" Margin="4,0,4,0" BorderBrush="#A855F7" BorderThickness="1">
                    <Grid>
                        <Border x:Name="Glow2" Width="3" HorizontalAlignment="Left" Background="#A855F7" CornerRadius="8,0,0,8"/>
                        <StackPanel Margin="18,16">
                            <StackPanel Orientation="Horizontal">
                                <fa:IconImage Icon="Box" Foreground="#A855F7" Width="14" Height="14"/>
                                <TextBlock Text="BOLSAS" FontSize="10" FontWeight="Bold" Foreground="#8B92A5" Margin="8,0,0,0"/>
                            </StackPanel>
                            <TextBlock Text="{Binding BolsasHoy}" FontSize="36" FontWeight="Bold" Foreground="#A855F7" Margin="0,8,0,0"/>
                            <TextBlock Text="producidas" FontSize="11" Foreground="#5A6275"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <Border Background="#1A1D27" CornerRadius="8" Margin="4,0,4,0" BorderBrush="#FF2D95" BorderThickness="1">
                    <Grid>
                        <Border x:Name="Glow3" Width="3" HorizontalAlignment="Left" Background="#FF2D95" CornerRadius="8,0,0,8"/>
                        <StackPanel Margin="18,16">
                            <StackPanel Orientation="Horizontal">
                                <fa:IconImage Icon="WeightHanging" Foreground="#FF2D95" Width="14" Height="14"/>
                                <TextBlock Text="KG" FontSize="10" FontWeight="Bold" Foreground="#8B92A5" Margin="8,0,0,0"/>
                            </StackPanel>
                            <TextBlock Text="{Binding KgHoy, StringFormat=N0}" FontSize="36" FontWeight="Bold" Foreground="#FF2D95" Margin="0,8,0,0"/>
                            <TextBlock Text="kilogramos" FontSize="11" Foreground="#5A6275"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <Border Background="#1A1D27" CornerRadius="8" Margin="8,0,0,0" BorderBrush="#22D3EE" BorderThickness="1">
                    <Grid>
                        <Border x:Name="Glow4" Width="3" HorizontalAlignment="Left" Background="#22D3EE" CornerRadius="8,0,0,8"/>
                        <StackPanel Margin="18,16">
                            <StackPanel Orientation="Horizontal">
                                <fa:IconImage Icon="Barcode" Foreground="#22D3EE" Width="14" Height="14"/>
                                <TextBlock Text="LOTES" FontSize="10" FontWeight="Bold" Foreground="#8B92A5" Margin="8,0,0,0"/>
                            </StackPanel>
                            <TextBlock Text="{Binding LotesActivos}" FontSize="36" FontWeight="Bold" Foreground="#22D3EE" Margin="0,8,0,0"/>
                            <TextBlock Text="activos" FontSize="11" Foreground="#5A6275"/>
                        </StackPanel>
                    </Grid>
                </Border>

            </UniformGrid>

            <Border Background="#12141C" CornerRadius="8" Padding="16,12" Margin="0,0,0,24"
                    BorderBrush="#2A2E3A" BorderThickness="1">
                <StackPanel Orientation="Horizontal">
                    <Ellipse x:Name="StatusDot" Width="8" Height="8" Fill="#00E5FF" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding MensajeEstado}" Margin="12,0,0,0"
                               VerticalAlignment="Center" FontSize="13" FontWeight="Medium" Foreground="#F1F5F9"/>
                </StackPanel>
            </Border>

            <TextBlock Text="QUICK ACCESS" FontSize="10" FontWeight="Bold" Foreground="#5A6275" Margin="0,0,0,12"/>

            <UniformGrid Columns="3">
                <Border Background="#1A1D27" CornerRadius="8" Padding="18" Margin="0,0,8,0" BorderBrush="#2A2E3A" BorderThickness="1">
                    <StackPanel>
                        <fa:IconImage Icon="Plus" Foreground="#00E5FF" Width="22" Height="22"/>
                        <TextBlock Text="Nuevo registro" FontWeight="Bold" FontSize="13" Foreground="#F1F5F9" Margin="0,10,0,0"/>
                        <TextBlock Text="Producción del turno" FontSize="11" Foreground="#8B92A5" Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>
                <Border Background="#1A1D27" CornerRadius="8" Padding="18" Margin="4,0,4,0" BorderBrush="#2A2E3A" BorderThickness="1">
                    <StackPanel>
                        <fa:IconImage Icon="Table" Foreground="#A855F7" Width="22" Height="22"/>
                        <TextBlock Text="Registro mensual" FontWeight="Bold" FontSize="13" Foreground="#F1F5F9" Margin="0,10,0,0"/>
                        <TextBlock Text="Planilla por lote" FontSize="11" Foreground="#8B92A5" Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>
                <Border Background="#1A1D27" CornerRadius="8" Padding="18" Margin="8,0,0,0" BorderBrush="#2A2E3A" BorderThickness="1">
                    <StackPanel>
                        <fa:IconImage Icon="ClockRotateLeft" Foreground="#FF2D95" Width="22" Height="22"/>
                        <TextBlock Text="Historial" FontWeight="Bold" FontSize="13" Foreground="#F1F5F9" Margin="0,10,0,0"/>
                        <TextBlock Text="Ver y eliminar" FontSize="11" Foreground="#8B92A5" Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>
            </UniformGrid>

        </StackPanel>
    </ScrollViewer>
</UserControl>
