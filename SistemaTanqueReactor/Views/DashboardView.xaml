<UserControl x:Class="SistemaTanqueReactor.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes">

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,4,0">
        <StackPanel>

            <!-- Header -->
            <Grid Margin="0,0,0,28">
                <StackPanel>
                    <TextBlock Text="Resumen de producción" Style="{StaticResource SectionTitle}" FontSize="20"/>
                    <TextBlock Text="Indicadores del tanque reactor · día actual"
                               FontSize="13" Foreground="#64748B" Margin="0,2,0,0"/>
                </StackPanel>
                <Button Style="{StaticResource OutlineButton}"
                        HorizontalAlignment="Right" VerticalAlignment="Center"
                        Command="{Binding RefrescarCommand}">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="Refresh" Width="16" Height="16" VerticalAlignment="Center"/>
                        <TextBlock Text="Actualizar" Margin="8,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </Grid>

            <!-- KPIs 2x2 -->
            <UniformGrid Columns="2" Rows="2" Margin="0,0,0,24">

                <Border Style="{StaticResource KpiCard}" Margin="0,0,12,12">
                    <Grid>
                        <StackPanel>
                            <Border Background="#CCFBF1" CornerRadius="14" Width="44" Height="44" HorizontalAlignment="Left">
                                <materialDesign:PackIcon Kind="ClipboardCheckOutline" Width="22" Height="22"
                                                         Foreground="#0D9488" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="{Binding RegistrosHoy}" FontSize="36" FontWeight="Bold"
                                       Foreground="#0F172A" Margin="0,16,0,0"/>
                            <TextBlock Text="Registros hoy" FontSize="13" Foreground="#64748B" Margin="0,2,0,0"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <Border Style="{StaticResource KpiCard}" Margin="12,0,0,12">
                    <Grid>
                        <StackPanel>
                            <Border Background="#CFFAFE" CornerRadius="14" Width="44" Height="44" HorizontalAlignment="Left">
                                <materialDesign:PackIcon Kind="PackageVariant" Width="22" Height="22"
                                                         Foreground="#0891B2" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="{Binding BolsasHoy}" FontSize="36" FontWeight="Bold"
                                       Foreground="#0F172A" Margin="0,16,0,0"/>
                            <TextBlock Text="Bolsas producidas hoy" FontSize="13" Foreground="#64748B" Margin="0,2,0,0"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <Border Style="{StaticResource KpiCard}" Margin="0,12,12,0">
                    <Grid>
                        <StackPanel>
                            <Border Background="#FEF3C7" CornerRadius="14" Width="44" Height="44" HorizontalAlignment="Left">
                                <materialDesign:PackIcon Kind="WeightKilogram" Width="22" Height="22"
                                                         Foreground="#D97706" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="{Binding KgHoy, StringFormat=N0}" FontSize="36" FontWeight="Bold"
                                       Foreground="#0F172A" Margin="0,16,0,0"/>
                            <TextBlock Text="Kilogramos hoy" FontSize="13" Foreground="#64748B" Margin="0,2,0,0"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <Border Style="{StaticResource KpiCard}" Margin="12,12,0,0">
                    <Grid>
                        <StackPanel>
                            <Border Background="#E0E7FF" CornerRadius="14" Width="44" Height="44" HorizontalAlignment="Left">
                                <materialDesign:PackIcon Kind="Barcode" Width="22" Height="22"
                                                         Foreground="#4F46E5" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="{Binding LotesActivos}" FontSize="36" FontWeight="Bold"
                                       Foreground="#0F172A" Margin="0,16,0,0"/>
                            <TextBlock Text="Lotes activos (con stock)" FontSize="13" Foreground="#64748B" Margin="0,2,0,0"/>
                        </StackPanel>
                    </Grid>
                </Border>

            </UniformGrid>

            <!-- Estado -->
            <Border Style="{StaticResource ModernCard}" Margin="0,0,0,16" Padding="18,16">
                <StackPanel Orientation="Horizontal">
                    <Border Background="#CCFBF1" CornerRadius="10" Width="36" Height="36">
                        <materialDesign:PackIcon Kind="InformationOutline" Width="18" Height="18"
                                                 Foreground="#0D9488" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="{Binding MensajeEstado}" Margin="14,0,0,0"
                               VerticalAlignment="Center" FontSize="14" Foreground="#475569"/>
                </StackPanel>
            </Border>

            <!-- Accesos rápidos -->
            <TextBlock Text="Accesos rápidos" Style="{StaticResource SectionTitle}" Margin="0,8,0,12"/>
            <UniformGrid Columns="3">
                <Border Style="{StaticResource ModernCard}" Margin="0,0,10,0" Padding="18" Cursor="Hand">
                    <StackPanel>
                        <materialDesign:PackIcon Kind="PlusBoxOutline" Width="28" Height="28" Foreground="#0D9488"/>
                        <TextBlock Text="Nuevo registro" FontWeight="SemiBold" FontSize="14" Margin="0,10,0,0" Foreground="#0F172A"/>
                        <TextBlock Text="Registrar producción del turno" FontSize="12" Foreground="#64748B" Margin="0,4,0,0" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource ModernCard}" Margin="5,0,5,0" Padding="18">
                    <StackPanel>
                        <materialDesign:PackIcon Kind="TableLarge" Width="28" Height="28" Foreground="#0891B2"/>
                        <TextBlock Text="Registro mensual" FontWeight="SemiBold" FontSize="14" Margin="0,10,0,0" Foreground="#0F172A"/>
                        <TextBlock Text="Planilla por lote, día y turno" FontSize="12" Foreground="#64748B" Margin="0,4,0,0" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource ModernCard}" Margin="10,0,0,0" Padding="18">
                    <StackPanel>
                        <materialDesign:PackIcon Kind="History" Width="28" Height="28" Foreground="#4F46E5"/>
                        <TextBlock Text="Historial" FontWeight="SemiBold" FontSize="14" Margin="0,10,0,0" Foreground="#0F172A"/>
                        <TextBlock Text="Ver, filtrar y eliminar registros" FontSize="12" Foreground="#64748B" Margin="0,4,0,0" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>
            </UniformGrid>

        </StackPanel>
    </ScrollViewer>
</UserControl>
