<UserControl x:Class="SistemaTanqueReactor.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             Background="#0C0E14">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel>

            <Grid Margin="0,0,0,24">
                <StackPanel>
                    <TextBlock Text="DASHBOARD" FontSize="11" FontWeight="Bold" Foreground="#00E5FF"/>
                    <TextBlock Text="Producción en vivo" FontSize="24" FontWeight="Bold" Foreground="#F1F5F9" Margin="0,4,0,0"/>
                </StackPanel>
                <Button HorizontalAlignment="Right" VerticalAlignment="Center"
                        Command="{Binding RefrescarCommand}" Style="{StaticResource PrimaryButton}"
                        Content="REFRESH" Padding="16,0"/>
            </Grid>

            <UniformGrid Columns="4" Margin="0,0,0,20">

                <Border Background="#1A1D27" CornerRadius="8" Margin="0,0,8,0" BorderBrush="#2A2E3A" BorderThickness="1">
                    <Grid>
                        <Border Width="3" HorizontalAlignment="Left" Background="#00E5FF" CornerRadius="8,0,0,8"/>
                        <StackPanel Margin="18,16">
                            <TextBlock Text="REGISTROS" FontSize="10" FontWeight="Bold" Foreground="#8B92A5"/>
                            <TextBlock Text="{Binding RegistrosHoy}" FontSize="36" FontWeight="Bold" Foreground="#00E5FF" Margin="0,8,0,0"/>
                            <TextBlock Text="hoy" FontSize="11" Foreground="#5A6275"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <Border Background="#1A1D27" CornerRadius="8" Margin="4,0,4,0" BorderBrush="#2A2E3A" BorderThickness="1">
                    <Grid>
                        <Border Width="3" HorizontalAlignment="Left" Background="#A855F7" CornerRadius="8,0,0,8"/>
                        <StackPanel Margin="18,16">
                            <TextBlock Text="BOLSAS" FontSize="10" FontWeight="Bold" Foreground="#8B92A5"/>
                            <TextBlock Text="{Binding BolsasHoy}" FontSize="36" FontWeight="Bold" Foreground="#A855F7" Margin="0,8,0,0"/>
                            <TextBlock Text="producidas" FontSize="11" Foreground="#5A6275"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <Border Background="#1A1D27" CornerRadius="8" Margin="4,0,4,0" BorderBrush="#2A2E3A" BorderThickness="1">
                    <Grid>
                        <Border Width="3" HorizontalAlignment="Left" Background="#FF2D95" CornerRadius="8,0,0,8"/>
                        <StackPanel Margin="18,16">
                            <TextBlock Text="KG" FontSize="10" FontWeight="Bold" Foreground="#8B92A5"/>
                            <TextBlock Text="{Binding KgHoy, StringFormat=N0}" FontSize="36" FontWeight="Bold" Foreground="#FF2D95" Margin="0,8,0,0"/>
                            <TextBlock Text="kilogramos" FontSize="11" Foreground="#5A6275"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <Border Background="#1A1D27" CornerRadius="8" Margin="8,0,0,0" BorderBrush="#2A2E3A" BorderThickness="1">
                    <Grid>
                        <Border Width="3" HorizontalAlignment="Left" Background="#22D3EE" CornerRadius="8,0,0,8"/>
                        <StackPanel Margin="18,16">
                            <TextBlock Text="LOTES" FontSize="10" FontWeight="Bold" Foreground="#8B92A5"/>
                            <TextBlock Text="{Binding LotesActivos}" FontSize="36" FontWeight="Bold" Foreground="#22D3EE" Margin="0,8,0,0"/>
                            <TextBlock Text="activos" FontSize="11" Foreground="#5A6275"/>
                        </StackPanel>
                    </Grid>
                </Border>

            </UniformGrid>

            <Border Background="#12141C" CornerRadius="8" Padding="16,12" Margin="0,0,0,24"
                    BorderBrush="#2A2E3A" BorderThickness="1">
                <StackPanel Orientation="Horizontal">
                    <Ellipse Width="8" Height="8" Fill="#00E5FF" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding MensajeEstado}" Margin="12,0,0,0"
                               VerticalAlignment="Center" FontSize="13" FontWeight="Medium" Foreground="#F1F5F9"/>
                </StackPanel>
            </Border>

            <TextBlock Text="QUICK ACCESS" FontSize="10" FontWeight="Bold" Foreground="#5A6275" Margin="0,0,0,12"/>

            <UniformGrid Columns="3">
                <Border Background="#1A1D27" CornerRadius="8" Padding="18" Margin="0,0,8,0" BorderBrush="#2A2E3A" BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="+" FontSize="22" FontWeight="Bold" Foreground="#00E5FF"/>
                        <TextBlock Text="Nuevo registro" FontWeight="Bold" FontSize="13" Foreground="#F1F5F9" Margin="0,8,0,0"/>
                        <TextBlock Text="Producción del turno" FontSize="11" Foreground="#8B92A5" Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>
                <Border Background="#1A1D27" CornerRadius="8" Padding="18" Margin="4,0,4,0" BorderBrush="#2A2E3A" BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="≡" FontSize="20" FontWeight="Bold" Foreground="#A855F7"/>
                        <TextBlock Text="Registro mensual" FontWeight="Bold" FontSize="13" Foreground="#F1F5F9" Margin="0,8,0,0"/>
                        <TextBlock Text="Planilla por lote" FontSize="11" Foreground="#8B92A5" Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>
                <Border Background="#1A1D27" CornerRadius="8" Padding="18" Margin="8,0,0,0" BorderBrush="#2A2E3A" BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="⏱" FontSize="18" Foreground="#FF2D95"/>
                        <TextBlock Text="Historial" FontWeight="Bold" FontSize="13" Foreground="#F1F5F9" Margin="0,8,0,0"/>
                        <TextBlock Text="Ver y eliminar" FontSize="11" Foreground="#8B92A5" Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>
            </UniformGrid>

        </StackPanel>
    </ScrollViewer>
</UserControl>
