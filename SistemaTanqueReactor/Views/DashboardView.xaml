<UserControl x:Class="SistemaTanqueReactor.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:fa="http://schemas.awesome.incremented/wpf/xaml/fontawesome.sharp"
             Background="#0C0E14">

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,4,0">
        <StackPanel>

            <!-- Header limpio -->
            <Grid Margin="0,0,0,28">
                <StackPanel>
                    <TextBlock Text="DASHBOARD" FontSize="11" FontWeight="Bold" Foreground="#00E5FF"/>
                    <TextBlock Text="Producción en vivo" Style="{StaticResource SectionTitle}" Margin="0,6,0,0"/>
                </StackPanel>
                <Button HorizontalAlignment="Right" VerticalAlignment="Center"
                        Command="{Binding RefrescarCommand}" Style="{StaticResource PrimaryButton}"
                        Content="Actualizar"/>
            </Grid>

            <!-- KPIs -->
            <UniformGrid Columns="4" Margin="0,0,0,24">
                <Border x:Name="Kpi1" Background="#1A1D27" CornerRadius="12" Margin="0,0,10,0"
                        BorderBrush="#2A2E3A" BorderThickness="1">
                    <Grid>
                        <Border x:Name="Glow1" Width="3" HorizontalAlignment="Left" Background="#00E5FF" CornerRadius="12,0,0,12"/>
                        <StackPanel Margin="20,18">
                            <TextBlock Text="REGISTROS" FontSize="10" FontWeight="Bold" Foreground="#8B92A5"/>
                            <TextBlock Text="{Binding RegistrosHoy}" FontSize="36" FontWeight="Bold" Foreground="#00E5FF" Margin="0,10,0,0"/>
                            <TextBlock Text="hoy" FontSize="12" Foreground="#5A6275" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <Border Background="#1A1D27" CornerRadius="12" Margin="5,0,5,0" BorderBrush="#2A2E3A" BorderThickness="1">
                    <Grid>
                        <Border x:Name="Glow2" Width="3" HorizontalAlignment="Left" Background="#A855F7" CornerRadius="12,0,0,12"/>
                        <StackPanel Margin="20,18">
                            <TextBlock Text="BOLSAS" FontSize="10" FontWeight="Bold" Foreground="#8B92A5"/>
                            <TextBlock Text="{Binding BolsasHoy}" FontSize="36" FontWeight="Bold" Foreground="#A855F7" Margin="0,10,0,0"/>
                            <TextBlock Text="producidas" FontSize="12" Foreground="#5A6275" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <Border Background="#1A1D27" CornerRadius="12" Margin="5,0,5,0" BorderBrush="#2A2E3A" BorderThickness="1">
                    <Grid>
                        <Border x:Name="Glow3" Width="3" HorizontalAlignment="Left" Background="#FF2D95" CornerRadius="12,0,0,12"/>
                        <StackPanel Margin="20,18">
                            <TextBlock Text="KG" FontSize="10" FontWeight="Bold" Foreground="#8B92A5"/>
                            <TextBlock Text="{Binding KgHoy, StringFormat=N0}" FontSize="36" FontWeight="Bold" Foreground="#FF2D95" Margin="0,10,0,0"/>
                            <TextBlock Text="kilogramos" FontSize="12" Foreground="#5A6275" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <Border Background="#1A1D27" CornerRadius="12" Margin="10,0,0,0" BorderBrush="#2A2E3A" BorderThickness="1">
                    <Grid>
                        <Border x:Name="Glow4" Width="3" HorizontalAlignment="Left" Background="#22D3EE" CornerRadius="12,0,0,12"/>
                        <StackPanel Margin="20,18">
                            <TextBlock Text="LOTES" FontSize="10" FontWeight="Bold" Foreground="#8B92A5"/>
                            <TextBlock Text="{Binding LotesActivos}" FontSize="36" FontWeight="Bold" Foreground="#22D3EE" Margin="0,10,0,0"/>
                            <TextBlock Text="activos" FontSize="12" Foreground="#5A6275" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </UniformGrid>

            <!-- Estado -->
            <Border Background="#12141C" CornerRadius="10" Padding="18,14" Margin="0,0,0,28"
                    BorderBrush="#2A2E3A" BorderThickness="1">
                <StackPanel Orientation="Horizontal">
                    <Ellipse x:Name="StatusDot" Width="8" Height="8" Fill="#00E5FF" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding MensajeEstado}" Margin="14,0,0,0"
                               VerticalAlignment="Center" FontSize="13" FontWeight="Medium" Foreground="#F1F5F9"/>
                </StackPanel>
            </Border>

            <TextBlock Text="ACCESOS RÁPIDOS" FontSize="11" FontWeight="Bold" Foreground="#5A6275" Margin="0,0,0,14"/>

            <UniformGrid Columns="3">
                <Border Background="#1A1D27" CornerRadius="12" Padding="22" Margin="0,0,10,0" BorderBrush="#2A2E3A" BorderThickness="1">
                    <StackPanel>
                        <fa:IconImage Icon="Plus" Foreground="#00E5FF" Width="20" Height="20"/>
                        <TextBlock Text="Nuevo registro" FontWeight="Bold" FontSize="14" Foreground="#F1F5F9" Margin="0,12,0,0"/>
                        <TextBlock Text="Producción del turno" FontSize="12" Foreground="#8B92A5" Margin="0,6,0,0"/>
                    </StackPanel>
                </Border>
                <Border Background="#1A1D27" CornerRadius="12" Padding="22" Margin="5,0,5,0" BorderBrush="#2A2E3A" BorderThickness="1">
                    <StackPanel>
                        <fa:IconImage Icon="Table" Foreground="#A855F7" Width="20" Height="20"/>
                        <TextBlock Text="Registro mensual" FontWeight="Bold" FontSize="14" Foreground="#F1F5F9" Margin="0,12,0,0"/>
                        <TextBlock Text="Planilla por lote" FontSize="12" Foreground="#8B92A5" Margin="0,6,0,0"/>
                    </StackPanel>
                </Border>
                <Border Background="#1A1D27" CornerRadius="12" Padding="22" Margin="10,0,0,0" BorderBrush="#2A2E3A" BorderThickness="1">
                    <StackPanel>
                        <fa:IconImage Icon="ClockRotateLeft" Foreground="#FF2D95" Width="20" Height="20"/>
                        <TextBlock Text="Historial" FontWeight="Bold" FontSize="14" Foreground="#F1F5F9" Margin="0,12,0,0"/>
                        <TextBlock Text="Ver y eliminar" FontSize="12" Foreground="#8B92A5" Margin="0,6,0,0"/>
                    </StackPanel>
                </Border>
            </UniformGrid>

        </StackPanel>
    </ScrollViewer>
</UserControl>
