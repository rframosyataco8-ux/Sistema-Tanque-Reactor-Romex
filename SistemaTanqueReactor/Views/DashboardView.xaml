<UserControl x:Class="SistemaTanqueReactor.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             Background="#F1F5F9">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="0,0,8,0">

            <Grid Margin="0,0,0,22">
                <StackPanel>
                    <TextBlock Text="Dashboard" FontSize="24" FontWeight="Bold" Foreground="#0F172A"/>
                    <TextBlock Text="Producción del día · Tanque Reactor" FontSize="13" Foreground="#64748B" Margin="0,4,0,0"/>
                </StackPanel>
                <Button HorizontalAlignment="Right" VerticalAlignment="Top"
                        Command="{Binding RefrescarCommand}" Cursor="Hand" BorderThickness="0">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="#0F172A" CornerRadius="8" Padding="16,10">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="Refresh" Width="15" Height="15" Foreground="White" VerticalAlignment="Center"/>
                                    <TextBlock Text="Actualizar" Margin="8,0,0,0" Foreground="White" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </Grid>

            <!-- KPI fila -->
            <UniformGrid Columns="4" Margin="0,0,0,20">
                <Border Background="White" CornerRadius="12" Padding="20" Margin="0,0,8,0" BorderBrush="#E2E8F0" BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="REGISTROS" FontSize="11" FontWeight="Bold" Foreground="#64748B"/>
                        <TextBlock Text="{Binding RegistrosHoy}" FontSize="36" FontWeight="Bold" Foreground="#0F172A" Margin="0,8,0,0"/>
                        <TextBlock Text="hoy" FontSize="12" Foreground="#94A3B8"/>
                    </StackPanel>
                </Border>
                <Border Background="White" CornerRadius="12" Padding="20" Margin="4,0,4,0" BorderBrush="#E2E8F0" BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="BOLSAS" FontSize="11" FontWeight="Bold" Foreground="#64748B"/>
                        <TextBlock Text="{Binding BolsasHoy}" FontSize="36" FontWeight="Bold" Foreground="#0F172A" Margin="0,8,0,0"/>
                        <TextBlock Text="producidas hoy" FontSize="12" Foreground="#94A3B8"/>
                    </StackPanel>
                </Border>
                <Border Background="White" CornerRadius="12" Padding="20" Margin="4,0,4,0" BorderBrush="#E2E8F0" BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="KILOGRAMOS" FontSize="11" FontWeight="Bold" Foreground="#64748B"/>
                        <TextBlock Text="{Binding KgHoy, StringFormat=N0}" FontSize="36" FontWeight="Bold" Foreground="#0F172A" Margin="0,8,0,0"/>
                        <TextBlock Text="kg hoy" FontSize="12" Foreground="#94A3B8"/>
                    </StackPanel>
                </Border>
                <Border Background="White" CornerRadius="12" Padding="20" Margin="8,0,0,0" BorderBrush="#E2E8F0" BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="LOTES" FontSize="11" FontWeight="Bold" Foreground="#64748B"/>
                        <TextBlock Text="{Binding LotesActivos}" FontSize="36" FontWeight="Bold" Foreground="#0F172A" Margin="0,8,0,0"/>
                        <TextBlock Text="con stock disponible" FontSize="12" Foreground="#94A3B8"/>
                    </StackPanel>
                </Border>
            </UniformGrid>

            <Border Background="White" CornerRadius="12" Padding="16,14" Margin="0,0,0,24" BorderBrush="#E2E8F0" BorderThickness="1">
                <TextBlock Text="{Binding MensajeEstado}" FontSize="14" FontWeight="Medium" Foreground="#334155"/>
            </Border>

            <TextBlock Text="Navegación" FontSize="13" FontWeight="Bold" Foreground="#0F172A" Margin="0,0,0,12"/>
            <UniformGrid Columns="3">
                <Border Background="White" CornerRadius="12" Padding="18" Margin="0,0,8,0" BorderBrush="#E2E8F0" BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="Nuevo registro" FontWeight="Bold" FontSize="14" Foreground="#0F172A"/>
                        <TextBlock Text="Cargar producción por turno" FontSize="12" Foreground="#64748B" Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>
                <Border Background="White" CornerRadius="12" Padding="18" Margin="4,0,4,0" BorderBrush="#E2E8F0" BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="Registro mensual" FontWeight="Bold" FontSize="14" Foreground="#0F172A"/>
                        <TextBlock Text="Planilla por lote y turno" FontSize="12" Foreground="#64748B" Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>
                <Border Background="White" CornerRadius="12" Padding="18" Margin="8,0,0,0" BorderBrush="#E2E8F0" BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="Historial" FontWeight="Bold" FontSize="14" Foreground="#0F172A"/>
                        <TextBlock Text="Consultar y eliminar" FontSize="12" Foreground="#64748B" Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>
            </UniformGrid>

        </StackPanel>
    </ScrollViewer>
</UserControl>
