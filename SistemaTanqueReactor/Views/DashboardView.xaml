<UserControl x:Class="SistemaTanqueReactor.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             Background="#0C0E14">

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,4,0">
        <StackPanel>

            <Grid Margin="0,0,0,28">
                <StackPanel>
                    <TextBlock Text="DASHBOARD" FontSize="11" FontWeight="Bold" Foreground="#00E5FF"/>
                    <TextBlock Text="Producción en vivo" Style="{StaticResource SectionTitle}" Margin="0,6,0,0"/>
                </StackPanel>
                <Button HorizontalAlignment="Right" VerticalAlignment="Center"
                        Command="{Binding RefrescarCommand}" Style="{StaticResource PrimaryButton}"
                        Content="Actualizar" Width="120"/>
            </Grid>

            <UniformGrid Columns="4" Margin="0,0,0,24">
                <Border Background="#1A1D27" CornerRadius="12" Margin="0,0,10,0" BorderBrush="#2A2E3A" BorderThickness="1">
                    <Grid>
                        <Border Width="3" HorizontalAlignment="Left" Background="#00E5FF" CornerRadius="12,0,0,12"/>
                        <StackPanel Margin="20,18">
                            <TextBlock Text="REGISTROS" FontSize="10" FontWeight="Bold" Foreground="#8B92A5"/>
                            <TextBlock Text="{Binding RegistrosHoy}" FontSize="36" FontWeight="Bold" Foreground="#00E5FF" Margin="0,10,0,0"/>
                            <TextBlock Text="hoy" FontSize="12" Foreground="#5A6275" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <Border Background="#1A1D27" CornerRadius="12" Margin="5,0,5,0" BorderBrush="#2A2E3A" BorderThickness="1">
                    <Grid>
                        <Border Width="3" HorizontalAlignment="Left" Background="#A855F7" CornerRadius="12,0,0,12"/>
                        <StackPanel Margin="20,18">
                            <TextBlock Text="BOLSAS" FontSize="10" FontWeight="Bold" Foreground="#8B92A5"/>
                            <TextBlock Text="{Binding BolsasHoy}" FontSize="36" FontWeight="Bold" Foreground="#A855F7" Margin="0,10,0,0"/>
                            <TextBlock Text="producidas" FontSize="12" Foreground="#5A6275" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <Border Background="#1A1D27" CornerRadius="12" Margin="5,0,5,0" BorderBrush="#2A2E3A" BorderThickness="1">
                    <Grid>
                        <Border Width="3" HorizontalAlignment="Left" Background="#FF2D95" CornerRadius="12,0,0,12"/>
                        <StackPanel Margin="20,18">
                            <TextBlock Text="KG" FontSize="10" FontWeight="Bold" Foreground="#8B92A5"/>
                            <TextBlock Text="{Binding KgHoy, StringFormat=N0}" FontSize="36" FontWeight="Bold" Foreground="#FF2D95" Margin="0,10,0,0"/>
                            <TextBlock Text="kilogramos" FontSize="12" Foreground="#5A6275" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <Border Background="#1A1D27" CornerRadius="12" Margin="10,0,0,0" BorderBrush="#2A2E3A" BorderThickness="1">
                    <Grid>
                        <Border Width="3" HorizontalAlignment="Left" Background="#22D3EE" CornerRadius="12,0,0,12"/>
                        <StackPanel Margin="20,18">
                            <TextBlock Text="LOTES" FontSize="10" FontWeight="Bold" Foreground="#8B92A5"/>
                            <TextBlock Text="{Binding LotesActivos}" FontSize="36" FontWeight="Bold" Foreground="#22D3EE" Margin="0,10,0,0"/>
                            <TextBlock Text="con stock" FontSize="12" Foreground="#5A6275" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </UniformGrid>

            <Border Background="#12141C" CornerRadius="10" Padding="18,14" Margin="0,0,0,28"
                    BorderBrush="#2A2E3A" BorderThickness="1">
                <StackPanel Orientation="Horizontal">
                    <Ellipse Width="8" Height="8" Fill="#00E5FF" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding MensajeEstado}" Margin="14,0,0,0"
                               VerticalAlignment="Center" FontSize="13" FontWeight="Medium" Foreground="#F1F5F9"/>
                </StackPanel>
            </Border>

            <TextBlock Text="CÓMO USAR EL SISTEMA" FontSize="11" FontWeight="Bold" Foreground="#5A6275" Margin="0,0,0,14"/>

            <UniformGrid Columns="3">
                <Border Background="#1A1D27" CornerRadius="12" Padding="20" Margin="0,0,10,0" BorderBrush="#2A2E3A" BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="1" FontSize="22" FontWeight="Bold" Foreground="#00E5FF"/>
                        <TextBlock Text="Crear lotes" FontWeight="Bold" FontSize="14" Foreground="#F1F5F9" Margin="0,10,0,0"/>
                        <TextBlock Text="Otros → Lotes · 400 bolsas por defecto" FontSize="12" Foreground="#8B92A5" Margin="0,6,0,0" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>
                <Border Background="#1A1D27" CornerRadius="12" Padding="20" Margin="5,0,5,0" BorderBrush="#2A2E3A" BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="2" FontSize="22" FontWeight="Bold" Foreground="#A855F7"/>
                        <TextBlock Text="Registrar producción" FontWeight="Bold" FontSize="14" Foreground="#F1F5F9" Margin="0,10,0,0"/>
                        <TextBlock Text="Nuevo Registro · suma 30+30 · valida stock" FontSize="12" Foreground="#8B92A5" Margin="0,6,0,0" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>
                <Border Background="#1A1D27" CornerRadius="12" Padding="20" Margin="10,0,0,0" BorderBrush="#2A2E3A" BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="3" FontSize="22" FontWeight="Bold" Foreground="#FF2D95"/>
                        <TextBlock Text="Ver planilla" FontWeight="Bold" FontSize="14" Foreground="#F1F5F9" Margin="0,10,0,0"/>
                        <TextBlock Text="Registro · doble clic edita · Excel exporta" FontSize="12" Foreground="#8B92A5" Margin="0,6,0,0" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>
            </UniformGrid>

        </StackPanel>
    </ScrollViewer>
</UserControl>
