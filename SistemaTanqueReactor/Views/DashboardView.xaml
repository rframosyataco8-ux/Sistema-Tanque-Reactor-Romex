<UserControl x:Class="SistemaTanqueReactor.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             Background="#EEF2FF">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="4">

            <!-- BANDA SUPERIOR OSCURA -->
            <Border Background="#0F172A" CornerRadius="16" Padding="28,22" Margin="0,0,0,20">
                <Grid>
                    <StackPanel>
                        <TextBlock Text="RESUMEN DE PRODUCCIÓN" FontSize="11" FontWeight="Bold"
                                   Foreground="#5EEAD4"/>
                        <TextBlock Text="Tanque Reactor" FontSize="26" FontWeight="Bold"
                                   Foreground="White" Margin="0,6,0,0"/>
                        <TextBlock Text="Indicadores del día actual · Planta Chincha"
                                   FontSize="13" Foreground="#94A3B8" Margin="0,4,0,0"/>
                    </StackPanel>
                    <Button HorizontalAlignment="Right" VerticalAlignment="Center"
                            Command="{Binding RefrescarCommand}" Cursor="Hand" BorderThickness="0">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="b" Background="#0D9488" CornerRadius="10" Padding="18,11">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="Refresh" Width="16" Height="16"
                                                                 Foreground="White" VerticalAlignment="Center"/>
                                        <TextBlock Text="Actualizar" Margin="8,0,0,0" Foreground="White"
                                                   FontWeight="SemiBold" FontSize="13" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="b" Property="Background" Value="#14B8A6"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </Grid>
            </Border>

            <!-- 4 KPI CON FONDO SÓLIDO -->
            <UniformGrid Columns="4" Margin="0,0,0,20">

                <Border Background="#0D9488" CornerRadius="16" Padding="20" Margin="0,0,8,0">
                    <StackPanel>
                        <materialDesign:PackIcon Kind="ClipboardCheck" Width="28" Height="28" Foreground="#CCFBF1"/>
                        <TextBlock Text="{Binding RegistrosHoy}" FontSize="40" FontWeight="Bold"
                                   Foreground="White" Margin="0,12,0,0"/>
                        <TextBlock Text="Registros hoy" FontSize="13" FontWeight="SemiBold"
                                   Foreground="#99F6E4" Margin="0,2,0,0"/>
                    </StackPanel>
                </Border>

                <Border Background="#0891B2" CornerRadius="16" Padding="20" Margin="4,0,4,0">
                    <StackPanel>
                        <materialDesign:PackIcon Kind="PackageVariantClosed" Width="28" Height="28" Foreground="#CFFAFE"/>
                        <TextBlock Text="{Binding BolsasHoy}" FontSize="40" FontWeight="Bold"
                                   Foreground="White" Margin="0,12,0,0"/>
                        <TextBlock Text="Bolsas hoy" FontSize="13" FontWeight="SemiBold"
                                   Foreground="#A5F3FC" Margin="0,2,0,0"/>
                    </StackPanel>
                </Border>

                <Border Background="#D97706" CornerRadius="16" Padding="20" Margin="4,0,4,0">
                    <StackPanel>
                        <materialDesign:PackIcon Kind="WeightKilogram" Width="28" Height="28" Foreground="#FEF3C7"/>
                        <TextBlock Text="{Binding KgHoy, StringFormat=N0}" FontSize="40" FontWeight="Bold"
                                   Foreground="White" Margin="0,12,0,0"/>
                        <TextBlock Text="Kilogramos hoy" FontSize="13" FontWeight="SemiBold"
                                   Foreground="#FDE68A" Margin="0,2,0,0"/>
                    </StackPanel>
                </Border>

                <Border Background="#4F46E5" CornerRadius="16" Padding="20" Margin="8,0,0,0">
                    <StackPanel>
                        <materialDesign:PackIcon Kind="Barcode" Width="28" Height="28" Foreground="#E0E7FF"/>
                        <TextBlock Text="{Binding LotesActivos}" FontSize="40" FontWeight="Bold"
                                   Foreground="White" Margin="0,12,0,0"/>
                        <TextBlock Text="Lotes activos" FontSize="13" FontWeight="SemiBold"
                                   Foreground="#C7D2FE" Margin="0,2,0,0"/>
                    </StackPanel>
                </Border>

            </UniformGrid>

            <!-- Estado -->
            <Border Background="White" CornerRadius="12" Padding="18,14" Margin="0,0,0,24"
                    BorderBrush="#0D9488" BorderThickness="2">
                <StackPanel Orientation="Horizontal">
                    <Ellipse Width="12" Height="12" Fill="#10B981" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding MensajeEstado}" Margin="12,0,0,0"
                               VerticalAlignment="Center" FontSize="15" FontWeight="SemiBold" Foreground="#0F172A"/>
                </StackPanel>
            </Border>

            <!-- Accesos -->
            <TextBlock Text="ACCESOS RÁPIDOS" FontSize="12" FontWeight="Bold" Foreground="#475569" Margin="0,0,0,12"/>

            <UniformGrid Columns="3">
                <Border Background="White" CornerRadius="14" Padding="20" Margin="0,0,8,0"
                        BorderBrush="#CBD5E1" BorderThickness="1.5">
                    <StackPanel>
                        <Border Background="#0D9488" CornerRadius="10" Width="42" Height="42" HorizontalAlignment="Left">
                            <materialDesign:PackIcon Kind="Plus" Width="24" Height="24" Foreground="White"
                                                     HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="Nuevo registro" FontWeight="Bold" FontSize="15" Margin="0,14,0,0" Foreground="#0F172A"/>
                        <TextBlock Text="Producción del turno" FontSize="12" Foreground="#64748B" Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>

                <Border Background="White" CornerRadius="14" Padding="20" Margin="4,0,4,0"
                        BorderBrush="#CBD5E1" BorderThickness="1.5">
                    <StackPanel>
                        <Border Background="#0891B2" CornerRadius="10" Width="42" Height="42" HorizontalAlignment="Left">
                            <materialDesign:PackIcon Kind="Table" Width="22" Height="22" Foreground="White"
                                                     HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="Registro mensual" FontWeight="Bold" FontSize="15" Margin="0,14,0,0" Foreground="#0F172A"/>
                        <TextBlock Text="Planilla lote · día · turno" FontSize="12" Foreground="#64748B" Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>

                <Border Background="White" CornerRadius="14" Padding="20" Margin="8,0,0,0"
                        BorderBrush="#CBD5E1" BorderThickness="1.5">
                    <StackPanel>
                        <Border Background="#4F46E5" CornerRadius="10" Width="42" Height="42" HorizontalAlignment="Left">
                            <materialDesign:PackIcon Kind="History" Width="22" Height="22" Foreground="White"
                                                     HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="Historial" FontWeight="Bold" FontSize="15" Margin="0,14,0,0" Foreground="#0F172A"/>
                        <TextBlock Text="Ver y eliminar registros" FontSize="12" Foreground="#64748B" Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>
            </UniformGrid>

        </StackPanel>
    </ScrollViewer>
</UserControl>
