<UserControl x:Class="SistemaTanqueReactor.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel>

            <!-- Título de sección -->
            <Grid Margin="0,0,0,24">
                <TextBlock Text="Resumen del día" FontSize="18" FontWeight="SemiBold"
                           Foreground="{StaticResource TextPrimaryBrush}"/>
                <Button Style="{StaticResource OutlineButton}"
                        HorizontalAlignment="Right"
                        Command="{Binding RefrescarCommand}"
                        Content="Actualizar"/>
            </Grid>

            <!-- Cards de resumen -->
            <UniformGrid Columns="3" Margin="0,0,0,32">

                <!-- Card 1: Total Cargas -->
                <Border Style="{StaticResource ModernCard}" Margin="0,0,16,0">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <Border Background="#E0F2F1" CornerRadius="10" Width="48" Height="48">
                                <materialDesign:PackIcon Kind="Factory" Width="26" Height="26" 
                                                         HorizontalAlignment="Center" VerticalAlignment="Center"
                                                         Foreground="{StaticResource PrimaryBrush}"/>
                            </Border>
                            <TextBlock Text="Cargas Hoy" VerticalAlignment="Center" Margin="14,0,0,0"
                                       Foreground="{StaticResource TextSecondaryBrush}" FontSize="14"/>
                        </StackPanel>
                        <TextBlock Text="{Binding TotalCargasHoy}" 
                                   FontSize="36" FontWeight="Bold" Margin="0,16,0,0"
                                   Foreground="{StaticResource TextPrimaryBrush}"/>
                        <TextBlock Text="registradas" FontSize="13" 
                                   Foreground="{StaticResource TextSecondaryBrush}"/>
                    </StackPanel>
                </Border>

                <!-- Card 2: Kg Torta -->
                <Border Style="{StaticResource ModernCard}" Margin="0,0,16,0">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <Border Background="#FEF3C7" CornerRadius="10" Width="48" Height="48">
                                <materialDesign:PackIcon Kind="PackageVariant" Width="26" Height="26" 
                                                         HorizontalAlignment="Center" VerticalAlignment="Center"
                                                         Foreground="#D97706"/>
                            </Border>
                            <TextBlock Text="Torta Trozada" VerticalAlignment="Center" Margin="14,0,0,0"
                                       Foreground="{StaticResource TextSecondaryBrush}" FontSize="14"/>
                        </StackPanel>
                        <TextBlock Text="{Binding TotalKgTortaHoy, StringFormat='{}{0:N0} kg'}" 
                                   FontSize="36" FontWeight="Bold" Margin="0,16,0,0"
                                   Foreground="{StaticResource TextPrimaryBrush}"/>
                        <TextBlock Text="consumidos hoy" FontSize="13" 
                                   Foreground="{StaticResource TextSecondaryBrush}"/>
                    </StackPanel>
                </Border>

                <!-- Card 3: Kg Merma -->
                <Border Style="{StaticResource ModernCard}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <Border Background="#FEE2E2" CornerRadius="10" Width="48" Height="48">
                                <materialDesign:PackIcon Kind="Recycle" Width="26" Height="26" 
                                                         HorizontalAlignment="Center" VerticalAlignment="Center"
                                                         Foreground="#DC2626"/>
                            </Border>
                            <TextBlock Text="Merma / Reproceso" VerticalAlignment="Center" Margin="14,0,0,0"
                                       Foreground="{StaticResource TextSecondaryBrush}" FontSize="14"/>
                        </StackPanel>
                        <TextBlock Text="{Binding TotalKgMermaHoy, StringFormat='{}{0:N0} kg'}" 
                                   FontSize="36" FontWeight="Bold" Margin="0,16,0,0"
                                   Foreground="{StaticResource TextPrimaryBrush}"/>
                        <TextBlock Text="utilizados hoy" FontSize="13" 
                                   Foreground="{StaticResource TextSecondaryBrush}"/>
                    </StackPanel>
                </Border>

            </UniformGrid>

            <!-- Mensaje de estado -->
            <Border Style="{StaticResource ModernCard}" Padding="20">
                <StackPanel Orientation="Horizontal">
                    <materialDesign:PackIcon Kind="InformationOutline" Width="22" Height="22"
                                             Foreground="{StaticResource PrimaryBrush}"
                                             VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding MensajeEstado}" Margin="12,0,0,0"
                               VerticalAlignment="Center"
                               Foreground="{StaticResource TextSecondaryBrush}"/>
                </StackPanel>
            </Border>

            <!-- Acceso rápido -->
            <TextBlock Text="Acceso rápido" FontSize="16" FontWeight="SemiBold" 
                       Margin="0,32,0,16" Foreground="{StaticResource TextPrimaryBrush}"/>

            <Border Style="{StaticResource ModernCard}">
                <StackPanel Orientation="Horizontal">
                    <materialDesign:PackIcon Kind="LightbulbOnOutline" Width="24" Height="24"
                                             Foreground="{StaticResource AccentBrush}"
                                             VerticalAlignment="Center"/>
                    <TextBlock Text="Usa el menú de la izquierda para registrar una nueva carga o consultar el historial completo."
                               Margin="14,0,0,0" VerticalAlignment="Center"
                               TextWrapping="Wrap" Foreground="{StaticResource TextSecondaryBrush}"/>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
