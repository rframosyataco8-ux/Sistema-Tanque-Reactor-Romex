<UserControl x:Class="SistemaTanqueReactor.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes">

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,4,0">
        <StackPanel>

            <!-- Header -->
            <Grid Margin="0,0,0,24">
                <StackPanel>
                    <TextBlock Text="Resumen de producción" FontSize="22" FontWeight="Bold" Foreground="#0F172A"/>
                    <TextBlock Text="Indicadores del tanque reactor · día actual"
                               FontSize="13" Foreground="#475569" Margin="0,4,0,0"/>
                </StackPanel>
                <Button HorizontalAlignment="Right" VerticalAlignment="Center"
                        Command="{Binding RefrescarCommand}" Cursor="Hand"
                        Background="#0F766E" Foreground="White" BorderThickness="0"
                        Padding="16,10" FontWeight="SemiBold" FontSize="13">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}" CornerRadius="10" Padding="{TemplateBinding Padding}">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="Refresh" Width="16" Height="16" VerticalAlignment="Center" Foreground="White"/>
                                    <TextBlock Text="Actualizar" Margin="8,0,0,0" VerticalAlignment="Center" Foreground="White"/>
                                </StackPanel>
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </Grid>

            <!-- KPIs 2x2 con color de fondo -->
            <UniformGrid Columns="2" Margin="0,0,0,20">

                <!-- Registros -->
                <Border Background="White" CornerRadius="16" Padding="22" Margin="0,0,10,10"
                        BorderBrush="#99F6E4" BorderThickness="2">
                    <StackPanel>
                        <Border Background="#0D9488" CornerRadius="12" Width="44" Height="44" HorizontalAlignment="Left">
                            <materialDesign:PackIcon Kind="ClipboardCheck" Width="22" Height="22"
                                                     Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="{Binding RegistrosHoy}" FontSize="42" FontWeight="Bold"
                                   Foreground="#0F172A" Margin="0,14,0,0"/>
                        <TextBlock Text="Registros hoy" FontSize="14" FontWeight="SemiBold" Foreground="#0F766E" Margin="0,2,0,0"/>
                    </StackPanel>
                </Border>

                <!-- Bolsas -->
                <Border Background="White" CornerRadius="16" Padding="22" Margin="10,0,0,10"
                        BorderBrush="#A5F3FC" BorderThickness="2">
                    <StackPanel>
                        <Border Background="#0891B2" CornerRadius="12" Width="44" Height="44" HorizontalAlignment="Left">
                            <materialDesign:PackIcon Kind="PackageVariantClosed" Width="22" Height="22"
                                                     Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="{Binding BolsasHoy}" FontSize="42" FontWeight="Bold"
                                   Foreground="#0F172A" Margin="0,14,0,0"/>
                        <TextBlock Text="Bolsas producidas hoy" FontSize="14" FontWeight="SemiBold" Foreground="#0E7490" Margin="0,2,0,0"/>
                    </StackPanel>
                </Border>

                <!-- Kg -->
                <Border Background="White" CornerRadius="16" Padding="22" Margin="0,10,10,0"
                        BorderBrush="#FDE68A" BorderThickness="2">
                    <StackPanel>
                        <Border Background="#D97706" CornerRadius="12" Width="44" Height="44" HorizontalAlignment="Left">
                            <materialDesign:PackIcon Kind="WeightKilogram" Width="22" Height="22"
                                                     Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="{Binding KgHoy, StringFormat=N0}" FontSize="42" FontWeight="Bold"
                                   Foreground="#0F172A" Margin="0,14,0,0"/>
                        <TextBlock Text="Kilogramos hoy" FontSize="14" FontWeight="SemiBold" Foreground="#B45309" Margin="0,2,0,0"/>
                    </StackPanel>
                </Border>

                <!-- Lotes -->
                <Border Background="White" CornerRadius="16" Padding="22" Margin="10,10,0,0"
                        BorderBrush="#C7D2FE" BorderThickness="2">
                    <StackPanel>
                        <Border Background="#4F46E5" CornerRadius="12" Width="44" Height="44" HorizontalAlignment="Left">
                            <materialDesign:PackIcon Kind="Barcode" Width="22" Height="22"
                                                     Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="{Binding LotesActivos}" FontSize="42" FontWeight="Bold"
                                   Foreground="#0F172A" Margin="0,14,0,0"/>
                        <TextBlock Text="Lotes activos (con stock)" FontSize="14" FontWeight="SemiBold" Foreground="#4338CA" Margin="0,2,0,0"/>
                    </StackPanel>
                </Border>

            </UniformGrid>

            <!-- Estado -->
            <Border Background="#ECFDF5" CornerRadius="12" Padding="16,14" Margin="0,0,0,24"
                    BorderBrush="#6EE7B7" BorderThickness="1">
                <StackPanel Orientation="Horizontal">
                    <Border Background="#059669" CornerRadius="8" Width="32" Height="32">
                        <materialDesign:PackIcon Kind="CheckCircle" Width="18" Height="18"
                                                 Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="{Binding MensajeEstado}" Margin="12,0,0,0"
                               VerticalAlignment="Center" FontSize="14" FontWeight="Medium" Foreground="#065F46"/>
                </StackPanel>
            </Border>

            <!-- Accesos rápidos -->
            <TextBlock Text="Accesos rápidos" FontSize="16" FontWeight="Bold" Foreground="#0F172A" Margin="0,0,0,14"/>

            <UniformGrid Columns="3">
                <Border Background="White" CornerRadius="14" Padding="18" Margin="0,0,8,0"
                        BorderBrush="#E2E8F0" BorderThickness="1">
                    <StackPanel>
                        <Border Background="#CCFBF1" CornerRadius="10" Width="40" Height="40" HorizontalAlignment="Left">
                            <materialDesign:PackIcon Kind="Plus" Width="22" Height="22" Foreground="#0F766E"
                                                     HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="Nuevo registro" FontWeight="Bold" FontSize="14" Margin="0,12,0,0" Foreground="#0F172A"/>
                        <TextBlock Text="Registrar producción del turno" FontSize="12" Foreground="#64748B" Margin="0,4,0,0" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>
                <Border Background="White" CornerRadius="14" Padding="18" Margin="4,0,4,0"
                        BorderBrush="#E2E8F0" BorderThickness="1">
                    <StackPanel>
                        <Border Background="#CFFAFE" CornerRadius="10" Width="40" Height="40" HorizontalAlignment="Left">
                            <materialDesign:PackIcon Kind="Table" Width="22" Height="22" Foreground="#0891B2"
                                                     HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="Registro mensual" FontWeight="Bold" FontSize="14" Margin="0,12,0,0" Foreground="#0F172A"/>
                        <TextBlock Text="Planilla por lote, día y turno" FontSize="12" Foreground="#64748B" Margin="0,4,0,0" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>
                <Border Background="White" CornerRadius="14" Padding="18" Margin="8,0,0,0"
                        BorderBrush="#E2E8F0" BorderThickness="1">
                    <StackPanel>
                        <Border Background="#E0E7FF" CornerRadius="10" Width="40" Height="40" HorizontalAlignment="Left">
                            <materialDesign:PackIcon Kind="History" Width="22" Height="22" Foreground="#4F46E5"
                                                     HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="Historial" FontWeight="Bold" FontSize="14" Margin="0,12,0,0" Foreground="#0F172A"/>
                        <TextBlock Text="Ver, filtrar y eliminar registros" FontSize="12" Foreground="#64748B" Margin="0,4,0,0" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>
            </UniformGrid>

        </StackPanel>
    </ScrollViewer>
</UserControl>
