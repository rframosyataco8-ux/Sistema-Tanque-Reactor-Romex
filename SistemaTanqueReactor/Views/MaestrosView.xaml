             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes">

    <TabControl Style="{StaticResource MaterialDesignTabControl}">
        <TabItem Header="Lotes">
            <ContentControl x:Name="LotesContent" Margin="0,16,0,0"/>
        </TabItem>
        <TabItem Header="Operarios">
            <ContentControl x:Name="OperariosContent" Margin="0,16,0,0"/>
        </TabItem>
    </TabControl>
</UserControl>
