<UserControl x:Class="SistemaTanqueReactor.Views.MaestrosView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             Background="#0C0E14">

    <TabControl Background="#0C0E14" BorderThickness="0">
        <TabControl.Resources>
            <Style TargetType="TabItem">
                <Setter Property="Foreground" Value="#8B92A5"/>
                <Setter Property="FontWeight" Value="Bold"/>
                <Setter Property="FontSize" Value="13"/>
                <Setter Property="Padding" Value="16,10"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="TabItem">
                            <Border x:Name="bd" Background="Transparent" Padding="{TemplateBinding Padding}" Margin="0,0,8,0"
                                    BorderBrush="Transparent" BorderThickness="0,0,0,2">
                                <ContentPresenter ContentSource="Header" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter TargetName="bd" Property="BorderBrush" Value="#00E5FF"/>
                                    <Setter Property="Foreground" Value="#00E5FF"/>
                                </Trigger>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Foreground" Value="#F1F5F9"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </TabControl.Resources>
        <TabItem Header="LOTES">
            <ContentControl x:Name="LotesContent" Margin="0,16,0,0"/>
        </TabItem>
        <TabItem Header="OPERARIOS">
            <ContentControl x:Name="OperariosContent" Margin="0,16,0,0"/>
        </TabItem>
    </TabControl>
</UserControl>
