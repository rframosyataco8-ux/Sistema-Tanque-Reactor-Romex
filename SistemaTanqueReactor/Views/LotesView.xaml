<UserControl x:Class="SistemaTanqueReactor.Views.LotesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Formulario -->
        <Border Grid.Row="0" Background="White" CornerRadius="14" Padding="20" Margin="0,0,0,16"
                BorderBrush="#E2E8F0" BorderThickness="1">
            <StackPanel>
                <TextBlock Text="Nuevo lote" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,14" Foreground="#0F172A"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Nº de Lote" Style="{StaticResource FieldLabel}"/>
                        <TextBox Text="{Binding NumeroLote}" Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                 materialDesign:HintAssist.Hint="Ej: 1572.0878" Height="42"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Bolsas" Style="{StaticResource FieldLabel}"/>
                        <TextBox Text="{Binding CantidadBolsas}" Style="{StaticResource MaterialDesignOutlinedTextBox}" Height="42"/>
                    </StackPanel>
                    <StackPanel Grid.Column="4">
                        <TextBlock Text="Fecha ingreso" Style="{StaticResource FieldLabel}"/>
                        <DatePicker SelectedDate="{Binding FechaIngreso}" Style="{StaticResource MaterialDesignOutlinedDatePicker}" Height="42"/>
                    </StackPanel>
                    <Button Grid.Column="6" Style="{StaticResource PrimaryButton}" Command="{Binding GuardarCommand}"
                            Content="Crear lote" VerticalAlignment="Bottom" Height="42" Padding="20,0"/>
                </Grid>
                <TextBlock Text="{Binding Mensaje}" Margin="0,10,0,0" FontSize="12" Foreground="#64748B"/>
            </StackPanel>
        </Border>

        <!-- Tabla -->
        <Border Grid.Row="1" Background="White" CornerRadius="14" BorderBrush="#E2E8F0" BorderThickness="1" ClipToBounds="True">
            <DataGrid ItemsSource="{Binding Lotes}" AutoGenerateColumns="False" IsReadOnly="True"
                      CanUserAddRows="False" HeadersVisibility="Column" BorderThickness="0"
                      GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#F1F5F9"
                      AlternatingRowBackground="#F8FAFC" RowBackground="White"
                      RowHeight="42" ColumnHeaderHeight="44" FontSize="13"
                      materialDesign:DataGridAssist.CellPadding="14,8">
                <DataGrid.ColumnHeaderStyle>
                    <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource {x:Type DataGridColumnHeader}}">
                        <Setter Property="Background" Value="#F1F5F9"/>
                        <Setter Property="Foreground" Value="#334155"/>
                        <Setter Property="FontWeight" Value="SemiBold"/>
                        <Setter Property="FontSize" Value="12"/>
                        <Setter Property="Padding" Value="14,10"/>
                        <Setter Property="BorderBrush" Value="#E2E8F0"/>
                        <Setter Property="BorderThickness" Value="0,0,0,1"/>
                    </Style>
                </DataGrid.ColumnHeaderStyle>
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Nº Lote" Binding="{Binding NumeroLote}" Width="*"/>
                    <DataGridTextColumn Header="Bolsas inicial" Binding="{Binding CantidadBolsasInicial}" Width="120"/>
                    <DataGridTextColumn Header="Disponible" Binding="{Binding CantidadBolsasDisponible}" Width="110"/>
                    <DataGridTextColumn Header="Despacho" Binding="{Binding DespachoBolsas}" Width="100"/>
                    <DataGridTextColumn Header="Stock (kg)" Binding="{Binding StockKg, StringFormat={}{0:N0}}" Width="110"/>
                    <DataGridTextColumn Header="Fecha ingreso" Binding="{Binding FechaIngreso, StringFormat=dd/MM/yyyy}" Width="130"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>
    </Grid>
</UserControl>
