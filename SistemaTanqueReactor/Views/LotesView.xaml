<UserControl x:Class="SistemaTanqueReactor.Views.LotesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes">

    <UserControl.Resources>
        <Style x:Key="InputOscuro" TargetType="TextBox" BasedOn="{StaticResource MaterialDesignOutlinedTextBox}">
            <Setter Property="Foreground" Value="#0F172A"/>
            <Setter Property="CaretBrush" Value="#0F172A"/>
        </Style>
        <Style x:Key="DateOscuro" TargetType="DatePicker" BasedOn="{StaticResource MaterialDesignOutlinedDatePicker}">
            <Setter Property="Foreground" Value="#0F172A"/>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="White" CornerRadius="14" Padding="20" Margin="0,0,0,16"
                BorderBrush="#E2E8F0" BorderThickness="1">
            <StackPanel>
                <TextBlock Text="Nuevo lote" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,14" Foreground="#0F172A"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Nº de Lote" Style="{StaticResource FieldLabel}"/>
                        <TextBox Text="{Binding NumeroLote}" Height="42" Style="{StaticResource InputOscuro}"
                                 materialDesign:HintAssist.Hint="Ej: 173260905"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Bolsas" Style="{StaticResource FieldLabel}"/>
                        <TextBox Text="{Binding CantidadBolsas}" Height="42" Style="{StaticResource InputOscuro}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="4">
                        <TextBlock Text="Fecha ingreso" Style="{StaticResource FieldLabel}"/>
                        <DatePicker SelectedDate="{Binding FechaIngreso}" Height="42" Style="{StaticResource DateOscuro}"/>
                    </StackPanel>
                    <Button Grid.Column="6" Style="{StaticResource PrimaryButton}" Command="{Binding GuardarCommand}"
                            Content="Crear lote" VerticalAlignment="Bottom" Height="42" Padding="20,0"/>
                </Grid>
                <TextBlock Text="{Binding Mensaje}" Margin="0,10,0,0" FontSize="12" Foreground="#64748B"/>
            </StackPanel>
        </Border>

        <Border Grid.Row="1" Background="White" CornerRadius="14" BorderBrush="#E2E8F0" BorderThickness="1" ClipToBounds="True">
            <DataGrid x:Name="DgLotes" ItemsSource="{Binding Lotes}" AutoGenerateColumns="False"
                      CanUserAddRows="False" HeadersVisibility="Column" BorderThickness="0"
                      GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#E2E8F0"
                      RowHeight="46" ColumnHeaderHeight="46" FontSize="13" Foreground="#0F172A"
                      LoadingRow="DgLotes_LoadingRow">
                <DataGrid.ColumnHeaderStyle>
                    <Style TargetType="DataGridColumnHeader">
                        <Setter Property="Background" Value="#F1F5F9"/>
                        <Setter Property="Foreground" Value="#1E293B"/>
                        <Setter Property="FontWeight" Value="SemiBold"/>
                        <Setter Property="FontSize" Value="12"/>
                        <Setter Property="Padding" Value="14,10"/>
                        <Setter Property="BorderBrush" Value="#E2E8F0"/>
                        <Setter Property="BorderThickness" Value="0,0,0,1"/>
                    </Style>
                </DataGrid.ColumnHeaderStyle>
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Nº Lote" Binding="{Binding NumeroLote}" Width="*" IsReadOnly="True"/>
                    <DataGridTextColumn Header="Bolsas inicial" Binding="{Binding CantidadBolsasInicial}" Width="120" IsReadOnly="True"/>
                    <DataGridTextColumn Header="Disponible" Binding="{Binding CantidadBolsasDisponible}" Width="110" IsReadOnly="True"/>
                    <DataGridTextColumn Header="Stock (kg)" Binding="{Binding StockKg, StringFormat={}{0:N0}}" Width="110" IsReadOnly="True"/>
                    <DataGridTemplateColumn Header="Despachado" Width="120">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <CheckBox IsChecked="{Binding Despachado, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                          HorizontalAlignment="Center" VerticalAlignment="Center"
                                          Command="{Binding DataContext.ToggleDespachadoCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                          CommandParameter="{Binding}"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Border>
    </Grid>
</UserControl>
