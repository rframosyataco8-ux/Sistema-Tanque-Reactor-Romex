<UserControl x:Class="SistemaTanqueReactor.Views.LotesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes">

    <DockPanel>
        <Border DockPanel.Dock="Top" Style="{StaticResource ModernCard}" Margin="0,0,0,16">
            <StackPanel>
                <TextBlock Text="Registrar nuevo lote" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,16"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Nº de Lote" Style="{StaticResource FieldLabel}"/>
                        <TextBox Text="{Binding NumeroLote}" Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                 materialDesign:HintAssist.Hint="Ej: 1572.0878"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Bolsas" Style="{StaticResource FieldLabel}"/>
                        <TextBox Text="{Binding CantidadBolsas}" Style="{StaticResource MaterialDesignOutlinedTextBox}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="4">
                        <TextBlock Text="Fecha ingreso" Style="{StaticResource FieldLabel}"/>
                        <DatePicker SelectedDate="{Binding FechaIngreso}" Style="{StaticResource MaterialDesignOutlinedDatePicker}"/>
                    </StackPanel>
                    <Button Grid.Column="6" Style="{StaticResource PrimaryButton}" Command="{Binding GuardarCommand}"
                            Content="Crear lote" VerticalAlignment="Bottom" Height="44"/>
                </Grid>
                <TextBlock Text="{Binding Mensaje}" Margin="0,12,0,0" Foreground="{StaticResource TextSecondaryBrush}"/>
            </StackPanel>
        </Border>

        <Border Style="{StaticResource ModernCard}" Padding="0">
            <DataGrid ItemsSource="{Binding Lotes}" AutoGenerateColumns="False" IsReadOnly="True"
                      CanUserAddRows="False" HeadersVisibility="Column"
                      materialDesign:DataGridAssist.CellPadding="12,8">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Nº Lote" Binding="{Binding NumeroLote}" Width="*"/>
                    <DataGridTextColumn Header="Bolsas inicial" Binding="{Binding CantidadBolsasInicial}" Width="110"/>
                    <DataGridTextColumn Header="Disponible" Binding="{Binding CantidadBolsasDisponible}" Width="100"/>
                    <DataGridTextColumn Header="Despacho" Binding="{Binding DespachoBolsas}" Width="90"/>
                    <DataGridTextColumn Header="Stock (kg)" Binding="{Binding StockKg}" Width="100"/>
                    <DataGridTextColumn Header="Fecha ingreso" Binding="{Binding FechaIngreso, StringFormat=dd/MM/yyyy}" Width="120"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>
    </DockPanel>
</UserControl>
