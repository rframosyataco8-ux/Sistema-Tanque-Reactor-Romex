<UserControl x:Class="SistemaTanqueReactor.Views.LotesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             Background="#0C0E14">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#1A1D27" CornerRadius="12" Padding="20" Margin="0,0,0,14"
                BorderBrush="#2A2E3A" BorderThickness="1">
            <StackPanel>
                <TextBlock Text="NUEVO LOTE" FontSize="11" FontWeight="Bold" Foreground="#00E5FF" Margin="0,0,0,14"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Nº DE LOTE" Style="{StaticResource FieldLabel}"/>
                        <TextBox Text="{Binding NumeroLote, UpdateSourceTrigger=PropertyChanged}" Height="42"
                                 materialDesign:HintAssist.Hint="Ej: 1572.0878"/>
                        <TextBlock Text="{Binding ErrorLote}" Foreground="#FF2D95" FontSize="11" Margin="0,4,0,0"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="BOLSAS" Style="{StaticResource FieldLabel}"/>
                        <TextBox Text="{Binding CantidadBolsas, UpdateSourceTrigger=PropertyChanged}" Height="42"/>
                        <TextBlock Text="{Binding ErrorBolsas}" Foreground="#FF2D95" FontSize="11" Margin="0,4,0,0"/>
                    </StackPanel>
                    <StackPanel Grid.Column="4">
                        <TextBlock Text="FECHA INGRESO" Style="{StaticResource FieldLabel}"/>
                        <DatePicker SelectedDate="{Binding FechaIngreso}" Height="42"/>
                        <TextBlock Text="{Binding ErrorFecha}" Foreground="#FF2D95" FontSize="11" Margin="0,4,0,0"/>
                    </StackPanel>
                    <Button Grid.Column="6" Style="{StaticResource PrimaryButton}" Command="{Binding GuardarCommand}"
                            Content="Crear lote" VerticalAlignment="Top" Height="42" Padding="18,0" Margin="0,22,0,0"/>
                </Grid>
                <TextBlock Text="{Binding Mensaje}" Margin="0,10,0,0" FontSize="12" Foreground="#8B92A5"/>
            </StackPanel>
        </Border>

        <Border Grid.Row="1" Background="#1A1D27" CornerRadius="12" BorderBrush="#2A2E3A" BorderThickness="1" ClipToBounds="True">
            <DataGrid ItemsSource="{Binding Lotes}" AutoGenerateColumns="False"
                      CanUserAddRows="False" HeadersVisibility="Column" BorderThickness="0"
                      GridLinesVisibility="None" Background="#1A1D27"
                      AlternatingRowBackground="#12141C" RowBackground="#1A1D27"
                      RowHeight="46" ColumnHeaderHeight="44" FontSize="13" Foreground="#F1F5F9"
                      IsReadOnly="False">
                <DataGrid.ColumnHeaderStyle>
                    <Style TargetType="DataGridColumnHeader">
                        <Setter Property="Background" Value="#12141C"/>
                        <Setter Property="Foreground" Value="#00E5FF"/>
                        <Setter Property="FontWeight" Value="Bold"/>
                        <Setter Property="FontSize" Value="11"/>
                        <Setter Property="Padding" Value="14,10"/>
                        <Setter Property="BorderBrush" Value="#2A2E3A"/>
                        <Setter Property="BorderThickness" Value="0,0,0,1"/>
                    </Style>
                </DataGrid.ColumnHeaderStyle>
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Nº LOTE" Binding="{Binding NumeroLote}" Width="*" IsReadOnly="True"/>
                    <DataGridTextColumn Header="INICIAL" Binding="{Binding CantidadBolsasInicial}" Width="100" IsReadOnly="True"/>
                    <DataGridTextColumn Header="DISPONIBLE" Binding="{Binding CantidadBolsasDisponible}" Width="110" IsReadOnly="True"/>
                    <DataGridTextColumn Header="STOCK KG" Binding="{Binding StockKg, StringFormat={}{0:N0}}" Width="110" IsReadOnly="True"/>
                    <DataGridTemplateColumn Header="DESPACHADO" Width="120">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <CheckBox IsChecked="{Binding Despachado, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                          HorizontalAlignment="Center" VerticalAlignment="Center"
                                          Command="{Binding DataContext.ToggleDespachadoCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                          CommandParameter="{Binding}"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Border>
    </Grid>
</UserControl>
