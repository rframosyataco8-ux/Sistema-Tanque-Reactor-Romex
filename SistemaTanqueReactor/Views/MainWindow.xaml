<Window x:Class="SistemaTanqueReactor.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="Tanque Reactor"
        Height="880" Width="1400"
        MinHeight="700" MinWidth="1024"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="False"
        Background="#F8FAFC"
        FontFamily="Segoe UI"
        TextElement.FontSize="14"
        TextElement.Foreground="#0F172A"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        RenderOptions.BitmapScalingMode="HighQuality"
        RenderOptions.ClearTypeHint="Enabled">

    <!-- CaptionHeight=56 permite arrastrar la barra superior nativamente -->
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="56"
                      ResizeBorderThickness="6"
                      GlassFrameThickness="0"
                      CornerRadius="0"
                      UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Border BorderBrush="#CBD5E1" BorderThickness="1" Background="#F8FAFC">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="ColSidebar" Width="250"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- SIDEBAR -->
            <Border Grid.Column="0" Background="#020617" x:Name="Sidebar">
                <DockPanel>

                    <Border DockPanel.Dock="Top" Padding="20,32,20,28"
                            MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                        <StackPanel HorizontalAlignment="Center">
                            <Border Width="52" Height="52" CornerRadius="14" HorizontalAlignment="Center" Margin="0,0,0,12">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                        <GradientStop Color="#14B8A6" Offset="0"/>
                                        <GradientStop Color="#0F766E" Offset="1"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                                <TextBlock Text="TR" FontSize="18" FontWeight="Bold" Foreground="White"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock x:Name="TxtLogoTitle" Text="Tanque Reactor" FontSize="15" FontWeight="Bold"
                                       Foreground="White" HorizontalAlignment="Center"/>
                            <TextBlock x:Name="TxtLogoSub" Text="Producción" FontSize="11"
                                       Foreground="#64748B" HorizontalAlignment="Center" Margin="0,3,0,0"/>
                        </StackPanel>
                    </Border>

                    <StackPanel DockPanel.Dock="Top" Margin="8,0" x:Name="NavPanel">
                        <TextBlock x:Name="LblMenu" Text="MENÚ" FontSize="10" FontWeight="Bold"
                                   Foreground="#475569" Margin="16,0,0,6"/>

                        <Button Style="{StaticResource NavButton}" Command="{Binding NavigateCommand}" CommandParameter="Dashboard">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="ViewDashboard" Width="20" Height="20" VerticalAlignment="Center"/>
                                <TextBlock Text="Dashboard" Margin="12,0,0,0" VerticalAlignment="Center" x:Name="TxtDash"/>
                            </StackPanel>
                        </Button>

                        <Button Style="{StaticResource NavButton}" Command="{Binding NavigateCommand}" CommandParameter="NuevaCarga">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="PlusCircleOutline" Width="20" Height="20" VerticalAlignment="Center"/>
                                <TextBlock Text="Nuevo Registro" Margin="12,0,0,0" VerticalAlignment="Center" x:Name="TxtNuevo"/>
                            </StackPanel>
                        </Button>

                        <Button Style="{StaticResource NavButton}" Command="{Binding NavigateCommand}" CommandParameter="Registro">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="Table" Width="20" Height="20" VerticalAlignment="Center"/>
                                <TextBlock Text="Registro" Margin="12,0,0,0" VerticalAlignment="Center" x:Name="TxtReg"/>
                            </StackPanel>
                        </Button>

                        <Button Style="{StaticResource NavButton}" Command="{Binding NavigateCommand}" CommandParameter="Historial">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="ClipboardTextClock" Width="20" Height="20" VerticalAlignment="Center"/>
                                <TextBlock Text="Historial" Margin="12,0,0,0" VerticalAlignment="Center" x:Name="TxtHist"/>
                            </StackPanel>
                        </Button>

                        <Border Height="1" Background="#1E293B" Margin="12,14" x:Name="SepConfig"/>

                        <TextBlock x:Name="LblOtros" Text="OTROS" FontSize="10" FontWeight="Bold"
                                   Foreground="#475569" Margin="16,0,0,6"/>

                        <Button Style="{StaticResource NavButton}" Command="{Binding NavigateCommand}" CommandParameter="Otros">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="Cog" Width="20" Height="20" VerticalAlignment="Center"/>
                                <TextBlock Text="Otros" Margin="12,0,0,0" VerticalAlignment="Center" x:Name="TxtOtros"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>

                    <Border DockPanel.Dock="Bottom" Margin="14,0,14,20" Background="#0F172A"
                            CornerRadius="12" Padding="14,12" VerticalAlignment="Bottom" x:Name="FooterBox">
                        <StackPanel>
                            <TextBlock Text="Planta Chincha" FontSize="12" FontWeight="SemiBold"
                                       Foreground="#94A3B8" HorizontalAlignment="Center"/>
                            <TextBlock Text="v2.0 · Tanque Reactor" FontSize="10" Foreground="#475569"
                                       HorizontalAlignment="Center" Margin="0,3,0,0"/>
                        </StackPanel>
                    </Border>

                </DockPanel>
            </Border>

            <!-- CONTENIDO -->
            <Grid Grid.Column="1" Background="#F8FAFC">
                <Grid.RowDefinitions>
                    <RowDefinition Height="56"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- BARRA SUPERIOR: arrastrable -->
                <Border x:Name="TitleBar" Grid.Row="0" Background="White"
                        BorderBrush="#E2E8F0" BorderThickness="0,0,0,1"
                        MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                    <Grid Margin="6,0,12,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- WindowChrome.IsHitTestVisibleInChrome=True para que el botón funcione sobre la zona de caption -->
                        <Button Grid.Column="0" Click="BtnMenu_Click" Cursor="Hand"
                                Width="42" Height="42" Background="Transparent" BorderThickness="0"
                                ToolTip="Menú"
                                WindowChrome.IsHitTestVisibleInChrome="True">
                            <materialDesign:PackIcon Kind="Menu" Width="22" Height="22" Foreground="#0F172A"/>
                        </Button>

                        <TextBlock Grid.Column="1" Text="{Binding CurrentPageTitle}"
                                   FontSize="17" FontWeight="SemiBold" Foreground="#0F172A"
                                   VerticalAlignment="Center" Margin="6,0,0,0"
                                   IsHitTestVisible="False"/>

                        <Border Grid.Column="2" Background="#F0FDFA" CornerRadius="8" Padding="12,6" Margin="0,0,10,0"
                                VerticalAlignment="Center" IsHitTestVisible="False">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="CalendarMonth" Width="15" Height="15"
                                                         Foreground="#0F766E" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding FechaActual, StringFormat='{}{0:ddd d MMM yyyy}'}"
                                           Margin="8,0,0,0" VerticalAlignment="Center"
                                           FontSize="12" FontWeight="Medium" Foreground="#0F766E"/>
                            </StackPanel>
                        </Border>

                        <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center"
                                    WindowChrome.IsHitTestVisibleInChrome="True">
                            <Button Width="40" Height="32" Click="BtnMin_Click" Background="Transparent"
                                    BorderThickness="0" Cursor="Hand" Foreground="#64748B" FontSize="14" Content="─"
                                    WindowChrome.IsHitTestVisibleInChrome="True"/>
                            <Button Width="40" Height="32" Click="BtnMax_Click" Background="Transparent"
                                    BorderThickness="0" Cursor="Hand" Foreground="#64748B" FontSize="11" Content="□"
                                    WindowChrome.IsHitTestVisibleInChrome="True"/>
                            <Button Width="40" Height="32" Click="BtnClose_Click" Background="Transparent"
                                    BorderThickness="0" Cursor="Hand" Foreground="#EF4444" FontSize="13" Content="✕"
                                    WindowChrome.IsHitTestVisibleInChrome="True"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <ContentControl Grid.Row="1" Content="{Binding CurrentView}" Margin="24,20,24,24"/>
            </Grid>

            <!-- Splash -->
            <Border x:Name="SplashOverlay" Grid.ColumnSpan="2" Background="#020617" Panel.ZIndex="100">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                    <Border Width="68" Height="68" CornerRadius="18" Margin="0,0,0,18">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#14B8A6" Offset="0"/>
                                <GradientStop Color="#0F766E" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                        <TextBlock Text="TR" FontSize="24" FontWeight="Bold" Foreground="White"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="Tanque Reactor" FontSize="22" FontWeight="Bold"
                               Foreground="White" HorizontalAlignment="Center"/>
                    <TextBlock Text="Iniciando..." FontSize="13" Foreground="#64748B"
                               HorizontalAlignment="Center" Margin="0,8,0,0"/>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>
