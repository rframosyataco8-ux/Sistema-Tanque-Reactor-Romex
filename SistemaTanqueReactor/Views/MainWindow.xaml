<Window x:Class="SistemaTanqueReactor.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:views="clr-namespace:SistemaTanqueReactor.Views"
        Title="Sistema Tanque Reactor - Romex S.A."
        Height="800" Width="1280"
        MinHeight="700" MinWidth="1100"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BackgroundBrush}"
        TextElement.Foreground="{StaticResource TextPrimaryBrush}"
        TextElement.FontWeight="Regular"
        TextElement.FontSize="14"
        FontFamily="Segoe UI">

    <materialDesign:DialogHost Identifier="RootDialog">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="260"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- SIDEBAR -->
            <Border Grid.Column="0" Background="{StaticResource PrimaryDarkBrush}">
                <DockPanel>
                    <!-- Logo / Título -->
                    <StackPanel DockPanel.Dock="Top" Margin="0,30,0,40" HorizontalAlignment="Center">
                        <TextBlock Text="ROMEX" 
                                   FontSize="28" FontWeight="Bold" 
                                   Foreground="White" HorizontalAlignment="Center"/>
                        <TextBlock Text="Tanque Reactor" 
                                   FontSize="13" 
                                   Foreground="#A7F3D0" HorizontalAlignment="Center"
                                   Margin="0,4,0,0"/>
                        <TextBlock Text="Planta Chincha" 
                                   FontSize="11" 
                                   Foreground="#6EE7B7" HorizontalAlignment="Center"
                                   Opacity="0.8"/>
                    </StackPanel>

                    <!-- Menú de navegación -->
                    <StackPanel Margin="12,0">
                        <Button Style="{StaticResource MaterialDesignFlatButton}"
                                Height="48" Margin="0,4"
                                HorizontalContentAlignment="Left"
                                Foreground="White"
                                Command="{Binding NavigateCommand}"
                                CommandParameter="Dashboard">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="ViewDashboard" Width="22" Height="22" VerticalAlignment="Center"/>
                                <TextBlock Text="Dashboard" Margin="14,0,0,0" VerticalAlignment="Center" FontSize="15"/>
                            </StackPanel>
                        </Button>

                        <Button Style="{StaticResource MaterialDesignFlatButton}"
                                Height="48" Margin="0,4"
                                HorizontalContentAlignment="Left"
                                Foreground="White"
                                Command="{Binding NavigateCommand}"
                                CommandParameter="NuevaCarga">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="PlusCircle" Width="22" Height="22" VerticalAlignment="Center"/>
                                <TextBlock Text="Nueva Carga" Margin="14,0,0,0" VerticalAlignment="Center" FontSize="15"/>
                            </StackPanel>
                        </Button>

                        <Button Style="{StaticResource MaterialDesignFlatButton}"
                                Height="48" Margin="0,4"
                                HorizontalContentAlignment="Left"
                                Foreground="White"
                                Command="{Binding NavigateCommand}"
                                CommandParameter="Historial">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="History" Width="22" Height="22" VerticalAlignment="Center"/>
                                <TextBlock Text="Historial" Margin="14,0,0,0" VerticalAlignment="Center" FontSize="15"/>
                            </StackPanel>
                        </Button>

                        <Separator Background="#0D9488" Margin="10,20" Opacity="0.4"/>

                        <Button Style="{StaticResource MaterialDesignFlatButton}"
                                Height="48" Margin="0,4"
                                HorizontalContentAlignment="Left"
                                Foreground="White"
                                Command="{Binding NavigateCommand}"
                                CommandParameter="Maestros">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="Database" Width="22" Height="22" VerticalAlignment="Center"/>
                                <TextBlock Text="Maestros" Margin="14,0,0,0" VerticalAlignment="Center" FontSize="15"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>

                    <!-- Footer -->
                    <StackPanel DockPanel.Dock="Bottom" VerticalAlignment="Bottom" Margin="0,0,0,20">
                        <TextBlock Text="v1.0.0" 
                                   Foreground="#6EE7B7" 
                                   HorizontalAlignment="Center"
                                   FontSize="11" Opacity="0.7"/>
                        <TextBlock Text="© Exportadora Romex S.A." 
                                   Foreground="#6EE7B7" 
                                   HorizontalAlignment="Center"
                                   FontSize="10" Opacity="0.5" Margin="0,4,0,0"/>
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- CONTENIDO PRINCIPAL -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Top bar -->
                <Border Grid.Row="0" Background="White" Padding="24,16"
                        BorderBrush="#E5E7EB" BorderThickness="0,0,0,1">
                    <Grid>
                        <TextBlock Text="{Binding CurrentPageTitle}" 
                                   FontSize="22" FontWeight="SemiBold"
                                   VerticalAlignment="Center"
                                   Foreground="{StaticResource TextPrimaryBrush}"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <TextBlock Text="{Binding FechaActual, StringFormat='{}{0:dddd, dd MMMM yyyy}'}" 
                                       VerticalAlignment="Center"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       Margin="0,0,16,0"/>
                            <materialDesign:PackIcon Kind="CalendarToday" 
                                                     Width="20" Height="20"
                                                     Foreground="{StaticResource PrimaryBrush}"
                                                     VerticalAlignment="Center"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Contenido dinámico -->
                <ContentControl Grid.Row="1" 
                                Content="{Binding CurrentView}"
                                Margin="24"/>
            </Grid>
        </Grid>
    </materialDesign:DialogHost>
</Window>
