<Window x:Class="SistemaTanqueReactor.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="Sistema Tanque Reactor · Romex S.A."
        Height="820" Width="1340"
        MinHeight="720" MinWidth="1120"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BackgroundBrush}"
        TextElement.Foreground="{StaticResource TextPrimaryBrush}"
        TextElement.FontWeight="Regular"
        TextElement.FontSize="14"
        FontFamily="Segoe UI">

    <materialDesign:DialogHost Identifier="RootDialog">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="250"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- ========== SIDEBAR OSCURO ========== -->
            <Border Grid.Column="0" Background="{StaticResource SidebarBrush}">
                <DockPanel>

                    <!-- Logo -->
                    <Border DockPanel.Dock="Top" Padding="0,36,0,32">
                        <StackPanel HorizontalAlignment="Center">
                            <Border Background="#0D9488" CornerRadius="14" Width="52" Height="52"
                                    HorizontalAlignment="Center" Margin="0,0,0,14">
                                <TextBlock Text="R" FontSize="26" FontWeight="Bold" Foreground="White"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="ROMEX" FontSize="20" FontWeight="Bold"
                                       Foreground="White" HorizontalAlignment="Center"
                                       LetterSpacing="2"/>
                            <TextBlock Text="Tanque Reactor" FontSize="12"
                                       Foreground="#64748B" HorizontalAlignment="Center"
                                       Margin="0,4,0,0"/>
                        </StackPanel>
                    </Border>

                    <!-- Navegación -->
                    <StackPanel DockPanel.Dock="Top" Margin="10,0">

                        <TextBlock Text="MENÚ" FontSize="10" FontWeight="SemiBold"
                                   Foreground="#475569" Margin="16,0,0,8"
                                   LetterSpacing="1"/>

                        <Button Style="{StaticResource NavButton}"
                                Command="{Binding NavigateCommand}"
                                CommandParameter="Dashboard">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="ViewDashboardOutline" Width="20" Height="20" VerticalAlignment="Center"/>
                                <TextBlock Text="Dashboard" Margin="14,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <Button Style="{StaticResource NavButton}"
                                Command="{Binding NavigateCommand}"
                                CommandParameter="NuevaCarga">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="PlusBoxOutline" Width="20" Height="20" VerticalAlignment="Center"/>
                                <TextBlock Text="Nuevo Registro" Margin="14,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <Button Style="{StaticResource NavButton}"
                                Command="{Binding NavigateCommand}"
                                CommandParameter="Historial">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="ClipboardTextClockOutline" Width="20" Height="20" VerticalAlignment="Center"/>
                                <TextBlock Text="Historial" Margin="14,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <Border Height="1" Background="#1E293B" Margin="12,18"/>

                        <TextBlock Text="CONFIGURACIÓN" FontSize="10" FontWeight="SemiBold"
                                   Foreground="#475569" Margin="16,0,0,8"
                                   LetterSpacing="1"/>

                        <Button Style="{StaticResource NavButton}"
                                Command="{Binding NavigateCommand}"
                                CommandParameter="Maestros">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="DatabaseOutline" Width="20" Height="20" VerticalAlignment="Center"/>
                                <TextBlock Text="Maestros" Margin="14,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>

                    <!-- Footer -->
                    <StackPanel DockPanel.Dock="Bottom" VerticalAlignment="Bottom" Margin="0,0,0,24">
                        <Border Background="#1E293B" CornerRadius="10" Margin="16,0" Padding="14,12">
                            <StackPanel>
                                <TextBlock Text="Planta Chincha" FontSize="12" FontWeight="SemiBold"
                                           Foreground="#94A3B8" HorizontalAlignment="Center"/>
                                <TextBlock Text="v1.0.0" FontSize="10"
                                           Foreground="#475569" HorizontalAlignment="Center"
                                           Margin="0,3,0,0"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                </DockPanel>
            </Border>

            <!-- ========== CONTENIDO PRINCIPAL ========== -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Top bar -->
                <Border Grid.Row="0" Background="White" Padding="28,18"
                        BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
                    <Grid>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="{Binding CurrentPageTitle}"
                                       FontSize="20" FontWeight="SemiBold"
                                       Foreground="{StaticResource TextPrimaryBrush}"/>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <Border Background="{StaticResource PrimaryLightBrush}" CornerRadius="8" Padding="12,6" Margin="0,0,12,0">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="CalendarToday" Width="16" Height="16"
                                                             Foreground="{StaticResource PrimaryBrush}"
                                                             VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding FechaActual, StringFormat='{}{0:dddd, dd MMM yyyy}'}"
                                               Margin="8,0,0,0" VerticalAlignment="Center"
                                               FontSize="13" FontWeight="Medium"
                                               Foreground="{StaticResource PrimaryDarkBrush}"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Contenido dinámico -->
                <ContentControl Grid.Row="1"
                                Content="{Binding CurrentView}"
                                Margin="28"/>
            </Grid>
        </Grid>
    </materialDesign:DialogHost>
</Window>
