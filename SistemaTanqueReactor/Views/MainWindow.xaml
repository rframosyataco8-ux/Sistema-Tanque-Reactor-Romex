<Window x:Class="SistemaTanqueReactor.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="Tanque Reactor · Registro de Producción"
        Height="860" Width="1380"
        MinHeight="700" MinWidth="1000"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="False"
        Background="#F8FAFC"
        FontFamily="Segoe UI"
        TextElement.FontSize="14"
        TextElement.Foreground="#0F172A"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        RenderOptions.BitmapScalingMode="HighQuality">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" ResizeBorderThickness="6" GlassFrameThickness="0"/>
    </WindowChrome.WindowChrome>

    <Border BorderBrush="#CBD5E1" BorderThickness="1" Background="#F8FAFC">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="ColSidebar" Width="260"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- ===== SIDEBAR ===== -->
            <Border Grid.Column="0" Background="#0B1220" x:Name="Sidebar">
                <DockPanel>

                    <!-- Logo TR -->
                    <Border DockPanel.Dock="Top" Padding="20,28,20,24">
                        <StackPanel HorizontalAlignment="Center">
                            <!-- Icono tanque estilizado -->
                            <Border Width="56" Height="56" CornerRadius="16"
                                    HorizontalAlignment="Center" Margin="0,0,0,12">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                        <GradientStop Color="#14B8A6" Offset="0"/>
                                        <GradientStop Color="#0F766E" Offset="1"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                                <Grid>
                                    <TextBlock Text="TR" FontSize="20" FontWeight="Bold" Foreground="White"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Grid>
                            </Border>
                            <TextBlock x:Name="TxtLogoTitle" Text="Tanque Reactor" FontSize="15" FontWeight="Bold"
                                       Foreground="White" HorizontalAlignment="Center"/>
                            <TextBlock x:Name="TxtLogoSub" Text="Registro de producción" FontSize="11"
                                       Foreground="#64748B" HorizontalAlignment="Center" Margin="0,3,0,0"/>
                        </StackPanel>
                    </Border>

                    <!-- Nav -->
                    <StackPanel DockPanel.Dock="Top" Margin="12,0" x:Name="NavPanel">
                        <TextBlock x:Name="LblMenu" Text="MENÚ" FontSize="10" FontWeight="Bold"
                                   Foreground="#475569" Margin="12,0,0,8"/>

                        <Button Style="{StaticResource NavButton}" Command="{Binding NavigateCommand}" CommandParameter="Dashboard">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="ViewDashboardOutline" Width="20" Height="20" VerticalAlignment="Center"/>
                                <TextBlock Text="Dashboard" Margin="12,0,0,0" VerticalAlignment="Center" x:Name="TxtDash"/>
                            </StackPanel>
                        </Button>

                        <Button Style="{StaticResource NavButton}" Command="{Binding NavigateCommand}" CommandParameter="NuevaCarga">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="PlusBoxOutline" Width="20" Height="20" VerticalAlignment="Center"/>
                                <TextBlock Text="Nuevo Registro" Margin="12,0,0,0" VerticalAlignment="Center" x:Name="TxtNuevo"/>
                            </StackPanel>
                        </Button>

                        <Button Style="{StaticResource NavButton}" Command="{Binding NavigateCommand}" CommandParameter="Registro">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="TableLarge" Width="20" Height="20" VerticalAlignment="Center"/>
                                <TextBlock Text="Registro" Margin="12,0,0,0" VerticalAlignment="Center" x:Name="TxtReg"/>
                            </StackPanel>
                        </Button>

                        <Button Style="{StaticResource NavButton}" Command="{Binding NavigateCommand}" CommandParameter="Historial">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="History" Width="20" Height="20" VerticalAlignment="Center"/>
                                <TextBlock Text="Historial" Margin="12,0,0,0" VerticalAlignment="Center" x:Name="TxtHist"/>
                            </StackPanel>
                        </Button>

                        <Border Height="1" Background="#1E293B" Margin="8,16" x:Name="SepConfig"/>

                        <TextBlock x:Name="LblOtros" Text="OTROS" FontSize="10" FontWeight="Bold"
                                   Foreground="#475569" Margin="12,0,0,8"/>

                        <Button Style="{StaticResource NavButton}" Command="{Binding NavigateCommand}" CommandParameter="Otros">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="CogOutline" Width="20" Height="20" VerticalAlignment="Center"/>
                                <TextBlock Text="Otros" Margin="12,0,0,0" VerticalAlignment="Center" x:Name="TxtOtros"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>

                    <!-- Footer -->
                    <Border DockPanel.Dock="Bottom" Margin="16,0,16,20" Background="#111827" CornerRadius="12" Padding="12"
                            VerticalAlignment="Bottom" x:Name="FooterBox">
                        <StackPanel>
                            <TextBlock Text="Planta Chincha" FontSize="12" FontWeight="SemiBold"
                                       Foreground="#94A3B8" HorizontalAlignment="Center" x:Name="TxtPlanta"/>
                            <TextBlock Text="v2.0" FontSize="10" Foreground="#475569"
                                       HorizontalAlignment="Center" Margin="0,2,0,0"/>
                        </StackPanel>
                    </Border>

                </DockPanel>
            </Border>

            <!-- ===== CONTENIDO ===== -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="56"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Top bar -->
                <Border Grid.Row="0" Background="White" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1">
                    <Grid Margin="8,0,20,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- Hamburguesa -->
                        <Button Grid.Column="0" Click="BtnMenu_Click" Cursor="Hand"
                                Width="44" Height="44" Background="Transparent" BorderThickness="0"
                                VerticalAlignment="Center" ToolTip="Menú">
                            <materialDesign:PackIcon Kind="Menu" Width="24" Height="24" Foreground="#0F172A"/>
                        </Button>

                        <TextBlock Grid.Column="1" Text="{Binding CurrentPageTitle}"
                                   FontSize="18" FontWeight="SemiBold" Foreground="#0F172A"
                                   VerticalAlignment="Center" Margin="8,0,0,0"/>

                        <Border Grid.Column="2" Background="#F0FDFA" CornerRadius="8" Padding="12,6" Margin="0,0,12,0"
                                VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="CalendarToday" Width="15" Height="15"
                                                         Foreground="#0D9488" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding FechaActual, StringFormat='{}{0:ddd, dd MMM yyyy}'}"
                                           Margin="8,0,0,0" VerticalAlignment="Center"
                                           FontSize="12" FontWeight="Medium" Foreground="#0F766E"/>
                            </StackPanel>
                        </Border>

                        <!-- Controles ventana -->
                        <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Content="─" Width="40" Height="32" Click="BtnMin_Click"
                                    Background="Transparent" BorderThickness="0" FontSize="14" Cursor="Hand" Foreground="#64748B"/>
                            <Button Content="☐" Width="40" Height="32" Click="BtnMax_Click"
                                    Background="Transparent" BorderThickness="0" FontSize="12" Cursor="Hand" Foreground="#64748B"/>
                            <Button Content="✕" Width="40" Height="32" Click="BtnClose_Click"
                                    Background="Transparent" BorderThickness="0" FontSize="14" Cursor="Hand" Foreground="#EF4444"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <ContentControl Grid.Row="1" Content="{Binding CurrentView}" Margin="24"/>
            </Grid>

            <!-- Splash overlay de entrada -->
            <Border x:Name="SplashOverlay" Grid.ColumnSpan="2" Background="#0B1220" Panel.ZIndex="100">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                    <Border Width="72" Height="72" CornerRadius="20" Margin="0,0,0,16">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#14B8A6" Offset="0"/>
                                <GradientStop Color="#0F766E" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                        <TextBlock Text="TR" FontSize="26" FontWeight="Bold" Foreground="White"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="Tanque Reactor" FontSize="22" FontWeight="Bold"
                               Foreground="White" HorizontalAlignment="Center"/>
                    <TextBlock Text="Cargando sistema..." FontSize="13" Foreground="#64748B"
                               HorizontalAlignment="Center" Margin="0,8,0,0"/>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>
