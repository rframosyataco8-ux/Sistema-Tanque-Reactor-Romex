<UserControl x:Class="SistemaTanqueReactor.Views.NuevoRegistroView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel MaxWidth="720" HorizontalAlignment="Left">

            <TextBlock Text="Registrar producción del día anterior"
                       FontSize="15" Foreground="{StaticResource TextSecondaryBrush}"
                       Margin="0,0,0,24"/>

            <Border Style="{StaticResource ModernCard}">
                <StackPanel>

                    <!-- Nº de Lote -->
                    <TextBlock Text="Nº de Lote" Style="{StaticResource FieldLabel}"/>
                    <Grid Margin="0,0,0,20">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <ComboBox Grid.Column="0"
                                  ItemsSource="{Binding Lotes}"
                                  Text="{Binding NumeroLote, UpdateSourceTrigger=PropertyChanged}"
                                  IsEditable="True"
                                  materialDesign:HintAssist.Hint="Selecciona o escribe un lote nuevo"
                                  Style="{StaticResource MaterialDesignOutlinedComboBox}"/>
                        <TextBlock Grid.Column="2" Text="400 bolsas = 10.000 kg"
                                   VerticalAlignment="Center" FontSize="12"
                                   Foreground="{StaticResource TextSecondaryBrush}"/>
                    </Grid>

                    <!-- Fecha + Turno -->
                    <Grid Margin="0,0,0,20">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="20"/>
                            <ColumnDefinition Width="180"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Fecha de Producción (día anterior)" Style="{StaticResource FieldLabel}"/>
                            <DatePicker SelectedDate="{Binding FechaProduccion}"
                                        Style="{StaticResource MaterialDesignOutlinedDatePicker}"/>
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Turno" Style="{StaticResource FieldLabel}"/>
                            <ComboBox ItemsSource="{Binding Turnos}"
                                      SelectedItem="{Binding Turno}"
                                      Style="{StaticResource MaterialDesignOutlinedComboBox}"/>
                        </StackPanel>
                    </Grid>

                    <!-- Cantidad con suma -->
                    <TextBlock Text="Cantidad (bolsas)" Style="{StaticResource FieldLabel}"/>
                    <TextBlock Text="Puedes escribir sumas: 30+30+28+2  →  Enter o botón para calcular"
                               FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,6"/>

                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBox Grid.Column="0"
                                 Text="{Binding CantidadTexto, UpdateSourceTrigger=PropertyChanged}"
                                 materialDesign:HintAssist.Hint="Ej: 30+28+2"
                                 Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                 FontSize="18" FontWeight="SemiBold">
                            <TextBox.InputBindings>
                                <KeyBinding Key="Return" Command="{Binding CalcularCantidadCommand}"/>
                            </TextBox.InputBindings>
                        </TextBox>

                        <Button Grid.Column="2" Style="{StaticResource OutlineButton}"
                                Command="{Binding CalcularCantidadCommand}" Content="Calcular"/>
                    </Grid>

                    <!-- Resultado del cálculo -->
                    <Border Background="#CCFBF1" CornerRadius="10" Padding="16,12" Margin="0,0,0,20"
                            Visibility="{Binding CantidadCalculada, Converter={StaticResource InverseBooleanConverter}, FallbackValue=Collapsed}">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="CheckCircle" Width="22" Height="22"
                                                     Foreground="#0D9488" VerticalAlignment="Center"/>
                            <TextBlock Margin="10,0,0,0" VerticalAlignment="Center" FontSize="15" FontWeight="SemiBold"
                                       Foreground="#0F766E">
                                <Run Text="Total: "/>
                                <Run Text="{Binding CantidadCalculada}" FontWeight="Bold"/>
                                <Run Text=" bolsas  =  "/>
                                <Run Text="{Binding CantidadCalculada, StringFormat={}{0:N0}}" FontWeight="Bold"/>
                                <Run Text=" × 25 = "/>
                                <Run Text="{Binding CantidadCalculada, Converter={x:Null}, StringFormat={}{0}}"/>
                            </TextBlock>
                        </StackPanel>
                    </Border>

                    <!-- Observaciones -->
                    <TextBlock Text="Observaciones (opcional)" Style="{StaticResource FieldLabel}"/>
                    <TextBox Text="{Binding Observaciones}"
                             Style="{StaticResource MaterialDesignOutlinedTextBox}"
                             AcceptsReturn="True" Height="60" TextWrapping="Wrap"
                             Margin="0,0,0,24"/>

                    <!-- Botón guardar -->
                    <Button Style="{StaticResource PrimaryButton}"
                            Command="{Binding GuardarCommand}"
                            HorizontalAlignment="Right"
                            Width="200" Content="Guardar Registro"/>

                    <TextBlock Text="{Binding Mensaje}" Margin="0,16,0,0"
                               Foreground="{StaticResource TextSecondaryBrush}" FontSize="13"/>

                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
