<UserControl x:Class="SistemaTanqueReactor.Views.NuevoRegistroView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             Background="#0C0E14">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel MaxWidth="700" HorizontalAlignment="Left">

            <TextBlock Text="NUEVO REGISTRO" FontSize="11" FontWeight="Bold" Foreground="#00E5FF"/>
            <TextBlock Text="Producción por turno" FontSize="22" FontWeight="Bold" Foreground="#F1F5F9" Margin="0,4,0,20"/>

            <Border Background="#1A1D27" CornerRadius="10" Padding="24" BorderBrush="#2A2E3A" BorderThickness="1">
                <StackPanel>

                    <TextBlock Text="Nº DE LOTE" Style="{StaticResource FieldLabel}"/>
                    <ComboBox ItemsSource="{Binding Lotes}"
                              Text="{Binding NumeroLote, UpdateSourceTrigger=PropertyChanged}"
                              IsEditable="True" Height="42"
                              materialDesign:HintAssist.Hint="Selecciona o escribe"/>
                    <TextBlock Text="{Binding ErrorLote}" Foreground="#FF2D95" FontSize="12" Margin="0,4,0,16"/>

                    <Grid Margin="0,0,0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="16"/>
                            <ColumnDefinition Width="140"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="FECHA" Style="{StaticResource FieldLabel}"/>
                            <DatePicker SelectedDate="{Binding FechaProduccion}" Height="42"/>
                            <TextBlock Text="{Binding ErrorFecha}" Foreground="#FF2D95" FontSize="12" Margin="0,4,0,0"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="TURNO" Style="{StaticResource FieldLabel}"/>
                            <ComboBox ItemsSource="{Binding Turnos}" SelectedItem="{Binding Turno}" Height="42" FontWeight="Bold"/>
                        </StackPanel>
                    </Grid>

                    <Border Height="1" Background="#2A2E3A" Margin="0,16,0,18"/>

                    <TextBlock Text="CANTIDAD (BOLSAS)" Style="{StaticResource FieldLabel}"/>
                    <TextBlock Text="Ej: 30+30+30+30" FontSize="11" Foreground="#5A6275" Margin="0,0,0,8"/>

                    <Grid Margin="0,0,0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="TxtCantidad" Grid.Column="0"
                                 Text="{Binding CantidadTexto, UpdateSourceTrigger=PropertyChanged}"
                                 FontSize="20" FontWeight="Bold" Height="46"
                                 materialDesign:HintAssist.Hint="120"
                                 PreviewKeyDown="TxtCantidad_PreviewKeyDown"/>
                        <Button Grid.Column="2" Command="{Binding CalcularCantidadCommand}"
                                Content="CALCULAR" Style="{StaticResource OutlineButton}" Width="120" Height="46"/>
                    </Grid>
                    <TextBlock Text="{Binding ErrorCantidad}" Foreground="#FF2D95" FontSize="12" Margin="0,4,0,12"/>

                    <Border Background="#12141C" CornerRadius="8" Padding="16" Margin="0,0,0,18"
                            BorderBrush="#00E5FF" BorderThickness="1"
                            Visibility="{Binding MostrarResultado, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock FontSize="22" FontWeight="Bold" Foreground="#00E5FF">
                                <Run Text="{Binding CantidadCalculada, Mode=OneWay}"/>
                                <Run Text=" bolsas" FontSize="13"/>
                            </TextBlock>
                            <TextBlock FontSize="16" FontWeight="SemiBold" Foreground="#A855F7" Margin="24,4,0,0" VerticalAlignment="Center">
                                <Run Text="{Binding CantidadKg, Mode=OneWay, StringFormat=N0}"/>
                                <Run Text=" kg"/>
                            </TextBlock>
                        </StackPanel>
                    </Border>

                    <TextBlock Text="OBSERVACIONES" Style="{StaticResource FieldLabel}"/>
                    <TextBox Text="{Binding Observaciones}" Height="60" TextWrapping="Wrap" AcceptsReturn="True"
                             Margin="0,0,0,22" materialDesign:HintAssist.Hint="Opcional"/>

                    <Grid>
                        <TextBlock Text="{Binding Mensaje}" VerticalAlignment="Center" Foreground="#8B92A5" FontSize="12"
                                   TextWrapping="Wrap" MaxWidth="340"/>
                        <Button Command="{Binding GuardarCommand}" HorizontalAlignment="Right"
                                Content="GUARDAR" Style="{StaticResource PrimaryButton}" Width="180" Height="44"/>
                    </Grid>

                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
