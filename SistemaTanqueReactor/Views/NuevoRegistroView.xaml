<UserControl x:Class="SistemaTanqueReactor.Views.NuevoRegistroView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             Background="#0C0E14">

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,4,0">
        <StackPanel MaxWidth="680" HorizontalAlignment="Left">

            <TextBlock Text="NUEVO REGISTRO" FontSize="11" FontWeight="Bold" Foreground="#00E5FF"/>
            <TextBlock Text="Producción por turno" Style="{StaticResource SectionTitle}" Margin="0,6,0,24"/>

            <Border Style="{StaticResource ModernCard}">
                <StackPanel>

                    <TextBlock Text="Nº DE LOTE" Style="{StaticResource FieldLabel}"/>
                    <ComboBox ItemsSource="{Binding Lotes}"
                              Text="{Binding NumeroLote, UpdateSourceTrigger=PropertyChanged}"
                              IsEditable="True" Height="44"
                              materialDesign:HintAssist.Hint="Selecciona o escribe"/>
                    <TextBlock Text="{Binding ErrorLote}" Style="{StaticResource ErrorText}" Margin="0,6,0,20"/>

                    <Grid Margin="0,0,0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="20"/>
                            <ColumnDefinition Width="140"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="FECHA" Style="{StaticResource FieldLabel}"/>
                            <DatePicker SelectedDate="{Binding FechaProduccion}" Height="44"/>
                            <TextBlock Text="{Binding ErrorFecha}" Style="{StaticResource ErrorText}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="TURNO" Style="{StaticResource FieldLabel}"/>
                            <ComboBox ItemsSource="{Binding Turnos}" SelectedItem="{Binding Turno}"
                                      Height="44" FontWeight="Bold"/>
                        </StackPanel>
                    </Grid>

                    <Border Height="1" Background="#2A2E3A" Margin="0,20,0,20"/>

                    <TextBlock Text="CANTIDAD (BOLSAS)" Style="{StaticResource FieldLabel}"/>
                    <TextBlock Text="Ejemplo: 30+30+30+30" FontSize="12" Foreground="#5A6275" Margin="0,0,0,10"/>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="TxtCantidad" Grid.Column="0"
                                 Text="{Binding CantidadTexto, UpdateSourceTrigger=PropertyChanged}"
                                 FontSize="20" FontWeight="Bold" Height="48"
                                 materialDesign:HintAssist.Hint="120"
                                 PreviewKeyDown="TxtCantidad_PreviewKeyDown"/>
                        <Button Grid.Column="2" Command="{Binding CalcularCantidadCommand}"
                                Content="Calcular" Style="{StaticResource OutlineButton}" Width="120" Height="48"/>
                    </Grid>
                    <TextBlock Text="{Binding ErrorCantidad}" Style="{StaticResource ErrorText}" Margin="0,6,0,16"/>

                    <Border Background="#12141C" CornerRadius="10" Padding="18" Margin="0,0,0,20"
                            BorderBrush="#00E5FF" BorderThickness="1"
                            Visibility="{Binding MostrarResultado, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock FontSize="22" FontWeight="Bold" Foreground="#00E5FF">
                                <Run Text="{Binding CantidadCalculada, Mode=OneWay}"/>
                                <Run Text=" bolsas" FontSize="13"/>
                            </TextBlock>
                            <TextBlock FontSize="16" FontWeight="SemiBold" Foreground="#A855F7" Margin="28,4,0,0" VerticalAlignment="Center">
                                <Run Text="{Binding CantidadKg, Mode=OneWay, StringFormat=N0}"/>
                                <Run Text=" kg"/>
                            </TextBlock>
                        </StackPanel>
                    </Border>

                    <TextBlock Text="OBSERVACIONES" Style="{StaticResource FieldLabel}"/>
                    <TextBox Text="{Binding Observaciones}" Height="64" TextWrapping="Wrap" AcceptsReturn="True"
                             Margin="0,0,0,24" materialDesign:HintAssist.Hint="Opcional"/>

                    <Grid>
                        <TextBlock Text="{Binding Mensaje}" VerticalAlignment="Center" Foreground="#8B92A5" FontSize="12"
                                   TextWrapping="Wrap" MaxWidth="320"/>
                        <Button Command="{Binding GuardarCommand}" HorizontalAlignment="Right"
                                Content="Guardar" Style="{StaticResource PrimaryButton}" Width="160"/>
                    </Grid>

                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
