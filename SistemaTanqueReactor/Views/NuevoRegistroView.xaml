<UserControl x:Class="SistemaTanqueReactor.Views.NuevoRegistroView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             Background="#F1F5F9">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel MaxWidth="720" HorizontalAlignment="Left">

            <TextBlock Text="Nuevo registro" FontSize="22" FontWeight="Bold" Foreground="#0F172A" Margin="0,0,0,4"/>
            <TextBlock Text="Turno I y II se guardan en celdas separadas del Registro mensual"
                       FontSize="13" Foreground="#64748B" Margin="0,0,0,20"/>

            <Border Background="White" CornerRadius="12" Padding="28" BorderBrush="#E2E8F0" BorderThickness="1">
                <StackPanel>

                    <TextBlock Text="Nº DE LOTE" FontSize="11" FontWeight="Bold" Foreground="#334155" Margin="0,0,0,6"/>
                    <ComboBox ItemsSource="{Binding Lotes}"
                              Text="{Binding NumeroLote, UpdateSourceTrigger=PropertyChanged}"
                              IsEditable="True" Height="44" FontSize="14" Foreground="#0F172A"
                              materialDesign:HintAssist.Hint="Selecciona o escribe un lote"/>
                    <TextBlock Text="{Binding ErrorLote}" Foreground="#DC2626" FontSize="12" Margin="0,4,0,16"
                               Visibility="{Binding ErrorLote, Converter={StaticResource BooleanToVisibilityConverter}}"/>

                    <Grid Margin="0,0,0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="16"/>
                            <ColumnDefinition Width="160"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="FECHA" FontSize="11" FontWeight="Bold" Foreground="#334155" Margin="0,0,0,6"/>
                            <DatePicker SelectedDate="{Binding FechaProduccion}" Height="44"
                                        FontSize="14" Foreground="#0F172A"/>
                            <TextBlock Text="{Binding ErrorFecha}" Foreground="#DC2626" FontSize="12" Margin="0,4,0,0"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="TURNO" FontSize="11" FontWeight="Bold" Foreground="#334155" Margin="0,0,0,6"/>
                            <ComboBox ItemsSource="{Binding Turnos}" SelectedItem="{Binding Turno}"
                                      Height="44" FontSize="15" FontWeight="SemiBold" Foreground="#0F172A"/>
                        </StackPanel>
                    </Grid>

                    <Border Height="1" Background="#E2E8F0" Margin="0,16,0,20"/>

                    <TextBlock Text="CANTIDAD (BOLSAS)" FontSize="11" FontWeight="Bold" Foreground="#334155" Margin="0,0,0,6"/>
                    <TextBlock Text="Números y +  ·  Ej: 30+30+30+30" FontSize="12" Foreground="#64748B" Margin="0,0,0,8"/>

                    <Grid Margin="0,0,0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="TxtCantidad" Grid.Column="0"
                                 Text="{Binding CantidadTexto, UpdateSourceTrigger=PropertyChanged}"
                                 FontSize="20" FontWeight="Bold" Height="48" Foreground="#0F172A"
                                 materialDesign:HintAssist.Hint="120 o 30+30+30+30"
                                 PreviewKeyDown="TxtCantidad_PreviewKeyDown"/>
                        <Button Grid.Column="2" Command="{Binding CalcularCantidadCommand}"
                                Content="Calcular" Width="120" Height="48" Cursor="Hand"
                                Background="#0F172A" Foreground="White" BorderThickness="0" FontWeight="SemiBold">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}" CornerRadius="8" Padding="12,0">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </Grid>
                    <TextBlock Text="{Binding ErrorCantidad}" Foreground="#DC2626" FontSize="12" Margin="0,4,0,12"/>

                    <Border Background="#F8FAFC" CornerRadius="10" Padding="16" Margin="0,0,0,20"
                            Visibility="{Binding MostrarResultado, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock FontSize="22" FontWeight="Bold" Foreground="#0F172A">
                                <Run Text="{Binding CantidadCalculada, Mode=OneWay}"/>
                                <Run Text=" bolsas" FontSize="14" FontWeight="SemiBold"/>
                            </TextBlock>
                            <TextBlock FontSize="16" FontWeight="SemiBold" Foreground="#64748B" Margin="20,4,0,0" VerticalAlignment="Center">
                                <Run Text="{Binding CantidadKg, Mode=OneWay, StringFormat=N0}"/>
                                <Run Text=" kg"/>
                            </TextBlock>
                        </StackPanel>
                    </Border>

                    <TextBlock Text="OBSERVACIONES" FontSize="11" FontWeight="Bold" Foreground="#334155" Margin="0,0,0,6"/>
                    <TextBox Text="{Binding Observaciones}" Height="64" TextWrapping="Wrap" AcceptsReturn="True"
                             FontSize="14" Foreground="#0F172A" Margin="0,0,0,24"
                             materialDesign:HintAssist.Hint="Opcional"/>

                    <Grid>
                        <TextBlock Text="{Binding Mensaje}" VerticalAlignment="Center" Foreground="#64748B" FontSize="13"
                                   TextWrapping="Wrap" MaxWidth="360"/>
                        <Button Command="{Binding GuardarCommand}" HorizontalAlignment="Right"
                                Content="Guardar registro" Height="46" Width="200" Cursor="Hand"
                                Background="#0F172A" Foreground="White" BorderThickness="0" FontWeight="SemiBold" FontSize="14">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}" CornerRadius="8">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </Grid>

                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
