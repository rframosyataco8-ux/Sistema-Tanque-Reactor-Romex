<UserControl x:Class="SistemaTanqueReactor.Views.HistorialMensualView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes">

    <DockPanel>

        <!-- Filtros -->
        <Border DockPanel.Dock="Top" Style="{StaticResource ModernCard}" Margin="0,0,0,16" Padding="20,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="120"/>
                    <ColumnDefinition Width="20"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="160"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="Año" VerticalAlignment="Center" FontWeight="SemiBold"/>
                <ComboBox Grid.Column="2" ItemsSource="{Binding Anios}" SelectedItem="{Binding Anio}"
                          Style="{StaticResource MaterialDesignOutlinedComboBox}"/>

                <TextBlock Grid.Column="4" Text="Mes" VerticalAlignment="Center" FontWeight="SemiBold"/>
                <ComboBox Grid.Column="6" ItemsSource="{Binding Meses}"
                          SelectedValue="{Binding Mes}" SelectedValuePath="Numero"
                          DisplayMemberPath="Nombre"
                          Style="{StaticResource MaterialDesignOutlinedComboBox}"/>

                <Button Grid.Column="8" Style="{StaticResource PrimaryButton}"
                        Command="{Binding BuscarCommand}" Content="Cargar mes"/>
            </Grid>
        </Border>

        <TextBlock DockPanel.Dock="Top" Text="{Binding Mensaje}"
                   Margin="0,0,0,10" Foreground="{StaticResource TextSecondaryBrush}"/>

        <TextBlock DockPanel.Dock="Top" Text="Doble clic en una celda de cantidad para ver el detalle de la suma"
                   FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,8"/>

        <!-- Tabla tipo Excel -->
        <Border Style="{StaticResource ModernCard}" Padding="0">
            <DataGrid x:Name="DgHistorial"
                      ItemsSource="{Binding TablaHistorial}"
                      AutoGenerateColumns="True"
                      IsReadOnly="True"
                      CanUserAddRows="False"
                      CanUserDeleteRows="False"
                      HeadersVisibility="Column"
                      GridLinesVisibility="All"
                      AlternatingRowBackground="#F8FAFC"
                      RowBackground="White"
                      FontSize="13"
                      materialDesign:DataGridAssist.CellPadding="10,8"
                      materialDesign:DataGridAssist.ColumnHeaderPadding="10,10"
                      MouseDoubleClick="DgHistorial_MouseDoubleClick"/>
        </Border>

    </DockPanel>
</UserControl>
