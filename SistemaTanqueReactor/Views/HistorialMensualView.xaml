<UserControl x:Class="SistemaTanqueReactor.Views.HistorialMensualView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes">

    <Grid Background="White">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Filtros: Año | Mes | MOSTRAR -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,16,0,12">
            <ComboBox ItemsSource="{Binding Anios}" SelectedItem="{Binding Anio}"
                      Width="100" Height="36" Margin="0,0,16,0"
                      FontSize="14" VerticalContentAlignment="Center"/>
            <ComboBox ItemsSource="{Binding Meses}"
                      SelectedValue="{Binding Mes}" SelectedValuePath="Numero"
                      DisplayMemberPath="Nombre"
                      Width="140" Height="36" Margin="0,0,16,0"
                      FontSize="14" VerticalContentAlignment="Center"/>
            <Button Command="{Binding BuscarCommand}"
                    Content="MOSTRAR"
                    Width="110" Height="36"
                    FontSize="13" FontWeight="SemiBold"
                    Background="White" BorderBrush="#1E293B" BorderThickness="1.5"
                    Cursor="Hand"/>
        </StackPanel>

        <!-- Mensaje / leyenda -->
        <TextBlock Grid.Row="1" Text="{Binding Mensaje}"
                   FontSize="12" Foreground="#64748B"
                   HorizontalAlignment="Center" Margin="0,0,0,8"/>

        <!-- PLANILLA: encabezado mes + fechas + grilla -->
        <Border Grid.Row="2" BorderBrush="#1E293B" BorderThickness="1" Margin="12,0,12,12"
                Background="White" ClipToBounds="True">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Fila 1: espacio fijo + mes fusionado -->
                <Grid Grid.Row="0" x:Name="FilaMes">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="300"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <!-- Celda vacía sobre columnas fijas -->
                    <Border Grid.Column="0" BorderBrush="#1E293B" BorderThickness="0,0,1,1" Background="White"/>
                    <!-- SEPTIEMBRE centrado sobre todas las fechas -->
                    <Border Grid.Column="1" BorderBrush="#1E293B" BorderThickness="0,0,0,1" Background="White">
                        <TextBlock Text="{Binding TituloMes}"
                                   FontSize="14" FontWeight="Bold"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Margin="0,6"/>
                    </Border>
                </Grid>

                <!-- Fila 2: espacio fijo + fechas (cada una ocupa 2 columnas visuales) -->
                <Grid Grid.Row="1" x:Name="FilaFechas">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="300"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Espacio sobre Nº LOTE | CANTIDAD | STOOCK -->
                    <Border Grid.Column="0" BorderBrush="#1E293B" BorderThickness="0,0,1,1" Background="White" Height="28"/>

                    <!-- Fechas: ItemsControl horizontal -->
                    <ScrollViewer x:Name="ScrollFechas" Grid.Column="1"
                                  HorizontalScrollBarVisibility="Hidden"
                                  VerticalScrollBarVisibility="Disabled">
                        <ItemsControl x:Name="ItemsFechas" ItemsSource="{Binding FechasEncabezado}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <!-- Cada fecha = ancho de I + II (52+52=104) -->
                                    <Border Width="104" BorderBrush="#1E293B" BorderThickness="0,0,1,1"
                                            Background="White">
                                        <TextBlock Text="{Binding}"
                                                   FontSize="11" FontWeight="SemiBold"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                                   Margin="2,4"/>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>

                <!-- Fila 3: DataGrid (headers = I / II solo) -->
                <DataGrid Grid.Row="2" x:Name="DgHistorial"
                          ItemsSource="{Binding TablaHistorial}"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          CanUserAddRows="False"
                          CanUserDeleteRows="False"
                          CanUserReorderColumns="False"
                          CanUserResizeRows="False"
                          CanUserSortColumns="False"
                          HeadersVisibility="Column"
                          GridLinesVisibility="All"
                          HorizontalGridLinesBrush="#94A3B8"
                          VerticalGridLinesBrush="#94A3B8"
                          AlternatingRowBackground="#F8FAFC"
                          RowBackground="White"
                          BorderThickness="0"
                          FontSize="12"
                          FontFamily="Segoe UI"
                          RowHeight="32"
                          ColumnHeaderHeight="28"
                          FrozenColumnCount="3"
                          EnableRowVirtualization="True"
                          SelectionUnit="Cell"
                          SelectionMode="Single"
                          MouseDoubleClick="DgHistorial_MouseDoubleClick"
                          ScrollViewer.ScrollChanged="DgHistorial_ScrollChanged"/>
            </Grid>
        </Border>
    </Grid>
</UserControl>
