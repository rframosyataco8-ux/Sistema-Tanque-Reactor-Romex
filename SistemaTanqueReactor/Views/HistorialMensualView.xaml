<UserControl x:Class="SistemaTanqueReactor.Views.HistorialMensualView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Background="White">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Año / Mes / MOSTRAR / EXCEL -->
        <StackPanel Grid.Row="0" Orientation="Horizontal"
                    HorizontalAlignment="Center" Margin="0,20,0,14">

            <Border BorderBrush="#0F172A" BorderThickness="1.5" CornerRadius="6" Margin="0,0,16,0" Padding="2">
                <ComboBox ItemsSource="{Binding Anios}"
                          SelectedItem="{Binding Anio}"
                          Width="100" Height="34"
                          FontSize="14" BorderThickness="0"
                          VerticalContentAlignment="Center" Padding="8,0"/>
            </Border>

            <Border BorderBrush="#0F172A" BorderThickness="1.5" CornerRadius="6" Margin="0,0,16,0" Padding="2">
                <ComboBox ItemsSource="{Binding Meses}"
                          SelectedValue="{Binding Mes}"
                          SelectedValuePath="Numero"
                          DisplayMemberPath="Nombre"
                          Width="140" Height="34"
                          FontSize="14" BorderThickness="0"
                          VerticalContentAlignment="Center" Padding="8,0"/>
            </Border>

            <Border BorderBrush="#0F172A" BorderThickness="1.5" CornerRadius="6" Margin="0,0,12,0">
                <Button Command="{Binding BuscarCommand}"
                        Content="MOSTRAR"
                        Width="110" Height="36"
                        FontSize="13" FontWeight="SemiBold"
                        Background="White" BorderThickness="0" Cursor="Hand"/>
            </Border>

            <Border Background="#0D9488" CornerRadius="6">
                <Button Command="{Binding ExportarExcelCommand}"
                        Content="EXCEL"
                        Width="100" Height="36"
                        FontSize="13" FontWeight="SemiBold"
                        Background="Transparent" Foreground="White"
                        BorderThickness="0" Cursor="Hand"/>
            </Border>
        </StackPanel>

        <TextBlock Grid.Row="1" Text="{Binding Mensaje}"
                   FontSize="12" Foreground="#64748B"
                   HorizontalAlignment="Center" Margin="0,0,0,10"/>

        <ScrollViewer Grid.Row="2"
                      HorizontalScrollBarVisibility="Auto"
                      VerticalScrollBarVisibility="Auto"
                      Margin="16,0,16,16">
            <StackPanel x:Name="PlanillaRoot" Orientation="Vertical" HorizontalAlignment="Left"/>
        </ScrollViewer>
    </Grid>
</UserControl>
