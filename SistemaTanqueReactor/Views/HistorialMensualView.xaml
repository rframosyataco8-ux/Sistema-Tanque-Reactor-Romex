<UserControl x:Class="SistemaTanqueReactor.Views.HistorialMensualView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        Imagen objetivo:

          [ 2026 ▼ ]    [ SEPTIEMBRE ▼ ]    [ MOSTRAR ]

                         ├────────── SEPTIEMBRE ──────────┤
                         │20/09/2026│21/09/2026│22/09/... │
        Nº DE LOTE│CANTIDAD_BOLSAS│STOOCK│ I │ II │ I │ II │...
    -->
    <Grid Background="White">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Año / Mes / MOSTRAR -->
        <StackPanel Grid.Row="0" Orientation="Horizontal"
                    HorizontalAlignment="Center" Margin="0,24,0,16">

            <Border BorderBrush="Black" BorderThickness="1.5" Margin="0,0,28,0">
                <ComboBox ItemsSource="{Binding Anios}"
                          SelectedItem="{Binding Anio}"
                          Width="100" Height="34"
                          FontSize="14" BorderThickness="0"
                          VerticalContentAlignment="Center"
                          Padding="8,0"/>
            </Border>

            <Border BorderBrush="Black" BorderThickness="1.5" Margin="0,0,28,0">
                <ComboBox ItemsSource="{Binding Meses}"
                          SelectedValue="{Binding Mes}"
                          SelectedValuePath="Numero"
                          DisplayMemberPath="Nombre"
                          Width="140" Height="34"
                          FontSize="14" BorderThickness="0"
                          VerticalContentAlignment="Center"
                          Padding="8,0"/>
            </Border>

            <Border BorderBrush="Black" BorderThickness="1.5">
                <Button Command="{Binding BuscarCommand}"
                        Content="MOSTRAR"
                        Width="120" Height="36"
                        FontSize="13" FontWeight="SemiBold"
                        Background="White" BorderThickness="0"
                        Cursor="Hand"/>
            </Border>
        </StackPanel>

        <TextBlock Grid.Row="1" Text="{Binding Mensaje}"
                   FontSize="12" Foreground="#64748B"
                   HorizontalAlignment="Center" Margin="0,0,0,10"/>

        <!-- Planilla completa generada en code-behind -->
        <ScrollViewer Grid.Row="2"
                      HorizontalScrollBarVisibility="Auto"
                      VerticalScrollBarVisibility="Auto"
                      Margin="20,0,20,20">
            <StackPanel x:Name="PlanillaRoot" Orientation="Vertical" HorizontalAlignment="Left"/>
        </ScrollViewer>
    </Grid>
</UserControl>
