<UserControl x:Class="SistemaTanqueReactor.Views.HistorialMensualView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#0C0E14">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,16,0,12">
            <Border Background="#1A1D27" BorderBrush="#2A2E3A" BorderThickness="1" CornerRadius="6" Margin="0,0,12,0" Padding="2">
                <ComboBox ItemsSource="{Binding Anios}" SelectedItem="{Binding Anio}"
                          Width="100" Height="36" FontSize="14" BorderThickness="0"
                          VerticalContentAlignment="Center" Padding="8,0"/>
            </Border>
            <Border Background="#1A1D27" BorderBrush="#2A2E3A" BorderThickness="1" CornerRadius="6" Margin="0,0,12,0" Padding="2">
                <ComboBox ItemsSource="{Binding Meses}" SelectedValue="{Binding Mes}"
                          SelectedValuePath="Numero" DisplayMemberPath="Nombre"
                          Width="140" Height="36" FontSize="14" BorderThickness="0"
                          VerticalContentAlignment="Center" Padding="8,0"/>
            </Border>
            <Button Command="{Binding BuscarCommand}" Content="MOSTRAR" Style="{StaticResource OutlineButton}"
                    Width="110" Height="36" Margin="0,0,10,0"/>
            <Button Command="{Binding ExportarExcelCommand}" Content="EXCEL" Style="{StaticResource PrimaryButton}"
                    Width="100" Height="36"/>
        </StackPanel>

        <TextBlock Grid.Row="1" Text="{Binding Mensaje}" FontSize="12" FontWeight="SemiBold"
                   Foreground="#8B92A5" HorizontalAlignment="Center" Margin="0,0,0,10"/>

        <!-- Columnas fijas (izq) + días con scroll (der) -->
        <Grid Grid.Row="2" Margin="12,0,12,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <ScrollViewer x:Name="ScrollFijas" Grid.Column="0"
                          VerticalScrollBarVisibility="Hidden"
                          HorizontalScrollBarVisibility="Disabled">
                <StackPanel x:Name="PlanillaFijas" Orientation="Vertical"/>
            </ScrollViewer>

            <ScrollViewer x:Name="ScrollDias" Grid.Column="1"
                          HorizontalScrollBarVisibility="Auto"
                          VerticalScrollBarVisibility="Auto"
                          ScrollChanged="ScrollDias_ScrollChanged">
                <StackPanel x:Name="PlanillaDias" Orientation="Vertical" HorizontalAlignment="Left"/>
            </ScrollViewer>
        </Grid>
    </Grid>
</UserControl>
