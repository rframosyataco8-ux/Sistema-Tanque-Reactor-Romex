<UserControl x:Class="SistemaTanqueReactor.Views.HistorialMensualView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Barra superior: mes + filtros -->
        <Border Grid.Row="0" Background="#0F766E" CornerRadius="12,12,0,0" Padding="0,14">
            <Grid>
                <TextBlock Text="{Binding TituloMes}"
                           FontSize="20" FontWeight="Bold" Foreground="White"
                           HorizontalAlignment="Center" VerticalAlignment="Center"/>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,16,0" VerticalAlignment="Center">
                    <ComboBox ItemsSource="{Binding Anios}" SelectedItem="{Binding Anio}"
                              Width="80" Height="34" Margin="0,0,8,0"
                              Background="White" FontSize="13"/>
                    <ComboBox ItemsSource="{Binding Meses}"
                              SelectedValue="{Binding Mes}" SelectedValuePath="Numero"
                              DisplayMemberPath="Nombre"
                              Width="130" Height="34" Margin="0,0,8,0"
                              Background="White" FontSize="13"/>
                    <Button Command="{Binding BuscarCommand}"
                            Background="#14B8A6" Foreground="White" BorderThickness="0"
                            Padding="14,6" Cursor="Hand" FontWeight="SemiBold">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="Refresh" Width="16" Height="16" VerticalAlignment="Center"/>
                            <TextBlock Text="Cargar" Margin="6,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Leyenda -->
        <Border Grid.Row="1" Background="#F0FDFA" BorderBrush="#99F6E4" BorderThickness="1,0,1,1" Padding="16,10">
            <Grid>
                <TextBlock Text="{Binding Mensaje}" FontSize="12" Foreground="#0F766E" VerticalAlignment="Center"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Border Background="#CCFBF1" CornerRadius="4" Padding="8,3" Margin="0,0,8,0">
                        <TextBlock Text="I = Turno Día" FontSize="11" FontWeight="SemiBold" Foreground="#0D9488"/>
                    </Border>
                    <Border Background="#E0E7FF" CornerRadius="4" Padding="8,3">
                        <TextBlock Text="II = Turno Noche" FontSize="11" FontWeight="SemiBold" Foreground="#4338CA"/>
                    </Border>
                    <TextBlock Text="  ·  Doble clic = detalle" FontSize="11" Foreground="#64748B"
                               VerticalAlignment="Center" Margin="8,0,0,0"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Planilla -->
        <Border Grid.Row="2" Background="White" BorderBrush="#CBD5E1" BorderThickness="1"
                CornerRadius="0,0,12,12" ClipToBounds="True">
            <DataGrid x:Name="DgHistorial"
                      ItemsSource="{Binding TablaHistorial}"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      CanUserAddRows="False"
                      CanUserDeleteRows="False"
                      CanUserReorderColumns="False"
                      CanUserResizeRows="False"
                      CanUserSortColumns="False"
                      HeadersVisibility="Column"
                      GridLinesVisibility="All"
                      HorizontalGridLinesBrush="#E2E8F0"
                      VerticalGridLinesBrush="#E2E8F0"
                      AlternatingRowBackground="#F8FAFC"
                      RowBackground="White"
                      BorderThickness="0"
                      FontSize="12"
                      FontFamily="Segoe UI"
                      RowHeight="34"
                      ColumnHeaderHeight="48"
                      FrozenColumnCount="3"
                      EnableRowVirtualization="True"
                      SelectionUnit="Cell"
                      SelectionMode="Single"
                      MouseDoubleClick="DgHistorial_MouseDoubleClick"/>
        </Border>
    </Grid>
</UserControl>
