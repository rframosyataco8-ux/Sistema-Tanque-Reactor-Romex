<UserControl x:Class="SistemaTanqueReactor.Views.HistorialMensualView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#0C0E14">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#1A1D27" CornerRadius="10" Padding="16,12" Margin="0,8,0,10"
                BorderBrush="#2A2E3A" BorderThickness="1" HorizontalAlignment="Center">
            <StackPanel Orientation="Horizontal">
                <ComboBox ItemsSource="{Binding Anios}" SelectedItem="{Binding Anio}"
                          Width="100" Height="36" FontSize="14" Margin="0,0,10,0"
                          VerticalContentAlignment="Center"/>
                <ComboBox ItemsSource="{Binding Meses}" SelectedValue="{Binding Mes}"
                          SelectedValuePath="Numero" DisplayMemberPath="Nombre"
                          Width="150" Height="36" FontSize="14" Margin="0,0,12,0"
                          VerticalContentAlignment="Center"/>
                <Button Command="{Binding BuscarCommand}" Content="Mostrar" Style="{StaticResource OutlineButton}"
                        Width="110" Height="36" Margin="0,0,10,0"/>
                <Button Command="{Binding ExportarExcelCommand}" Content="Excel" Style="{StaticResource PrimaryButton}"
                        Width="100" Height="36"/>
            </StackPanel>
        </Border>

        <StackPanel Grid.Row="1" Margin="0,0,0,10" HorizontalAlignment="Center">
            <TextBlock Text="{Binding Mensaje}" FontSize="12" FontWeight="SemiBold"
                       Foreground="#8B92A5" HorizontalAlignment="Center"/>
            <TextBlock Text="I = Turno día  ·  II = Turno noche  ·  Doble clic = editar celda"
                       FontSize="11" Foreground="#5A6275" HorizontalAlignment="Center" Margin="0,4,0,0"/>
        </StackPanel>

        <Grid Grid.Row="2" Margin="8,0,8,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="#12141C" BorderBrush="#2A2E3A" BorderThickness="1,1,0,1" CornerRadius="8,0,0,8">
                <ScrollViewer x:Name="ScrollFijas" VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel x:Name="PlanillaFijas" Orientation="Vertical"/>
                </ScrollViewer>
            </Border>

            <Border Grid.Column="1" Background="#12141C" BorderBrush="#2A2E3A" BorderThickness="1" CornerRadius="0,8,8,0">
                <ScrollViewer x:Name="ScrollDias"
                              HorizontalScrollBarVisibility="Auto"
                              VerticalScrollBarVisibility="Auto"
                              ScrollChanged="ScrollDias_ScrollChanged">
                    <StackPanel x:Name="PlanillaDias" Orientation="Vertical" HorizontalAlignment="Left"/>
                </ScrollViewer>
            </Border>
        </Grid>
    </Grid>
</UserControl>
