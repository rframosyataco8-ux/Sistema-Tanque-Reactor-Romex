<UserControl x:Class="SistemaTanqueReactor.Views.OperariosView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             Background="#0C0E14">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#1A1D27" CornerRadius="10" Padding="20" Margin="0,0,0,14"
                BorderBrush="#2A2E3A" BorderThickness="1">
            <StackPanel>
                <TextBlock Text="NUEVO OPERARIO" FontSize="11" FontWeight="Bold" Foreground="#00E5FF" Margin="0,0,0,12"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="140"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="NOMBRES" Style="{StaticResource FieldLabel}"/>
                        <TextBox Text="{Binding Nombres}" Height="40" materialDesign:HintAssist.Hint="Ej: Marco"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="APELLIDOS" Style="{StaticResource FieldLabel}"/>
                        <TextBox Text="{Binding Apellidos}" Height="40"/>
                    </StackPanel>
                    <StackPanel Grid.Column="4">
                        <TextBlock Text="DNI" Style="{StaticResource FieldLabel}"/>
                        <TextBox Text="{Binding Dni}" Height="40"/>
                    </StackPanel>
                    <Button Grid.Column="6" Style="{StaticResource PrimaryButton}" Command="{Binding GuardarCommand}"
                            Content="GUARDAR" VerticalAlignment="Bottom" Height="40" Width="120"/>
                </Grid>
                <TextBlock Text="{Binding Mensaje}" Margin="0,10,0,0" FontSize="12" Foreground="#8B92A5"/>
            </StackPanel>
        </Border>

        <Border Grid.Row="1" Background="#1A1D27" CornerRadius="10" BorderBrush="#2A2E3A" BorderThickness="1" ClipToBounds="True">
            <DataGrid ItemsSource="{Binding Operarios}" AutoGenerateColumns="False" IsReadOnly="True"
                      CanUserAddRows="False" HeadersVisibility="Column" BorderThickness="0"
                      GridLinesVisibility="None" Background="#1A1D27"
                      AlternatingRowBackground="#12141C" RowBackground="#1A1D27"
                      RowHeight="44" ColumnHeaderHeight="44" FontSize="13" Foreground="#F1F5F9">
                <DataGrid.ColumnHeaderStyle>
                    <Style TargetType="DataGridColumnHeader">
                        <Setter Property="Background" Value="#12141C"/>
                        <Setter Property="Foreground" Value="#00E5FF"/>
                        <Setter Property="FontWeight" Value="Bold"/>
                        <Setter Property="FontSize" Value="11"/>
                        <Setter Property="Padding" Value="14,10"/>
                        <Setter Property="BorderBrush" Value="#2A2E3A"/>
                        <Setter Property="BorderThickness" Value="0,0,0,1"/>
                    </Style>
                </DataGrid.ColumnHeaderStyle>
                <DataGrid.Columns>
                    <DataGridTextColumn Header="NOMBRES" Binding="{Binding Nombres}" Width="*"/>
                    <DataGridTextColumn Header="APELLIDOS" Binding="{Binding Apellidos}" Width="*"/>
                    <DataGridTextColumn Header="DNI" Binding="{Binding Dni}" Width="130"/>
                    <DataGridTextColumn Header="REGISTRO" Binding="{Binding FechaRegistro, StringFormat=dd/MM/yyyy}" Width="140"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>
    </Grid>
</UserControl>
