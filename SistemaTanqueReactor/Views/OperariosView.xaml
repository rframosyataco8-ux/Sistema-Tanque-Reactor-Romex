<UserControl x:Class="SistemaTanqueReactor.Views.OperariosView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="White" CornerRadius="14" Padding="20" Margin="0,0,0,16"
                BorderBrush="#E2E8F0" BorderThickness="1">
            <StackPanel>
                <TextBlock Text="Nuevo operario" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,14" Foreground="#0F172A"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="140"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Nombres" Style="{StaticResource FieldLabel}"/>
                        <TextBox Text="{Binding Nombres}" Height="42"
                                 materialDesign:HintAssist.Hint="Ej: Marco"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Apellidos" Style="{StaticResource FieldLabel}"/>
                        <TextBox Text="{Binding Apellidos}" Height="42"/>
                    </StackPanel>
                    <StackPanel Grid.Column="4">
                        <TextBlock Text="DNI" Style="{StaticResource FieldLabel}"/>
                        <TextBox Text="{Binding Dni}" Height="42"/>
                    </StackPanel>
                    <Button Grid.Column="6" Style="{StaticResource PrimaryButton}" Command="{Binding GuardarCommand}"
                            Content="Guardar" VerticalAlignment="Bottom" Height="42" Width="120"/>
                </Grid>
                <TextBlock Text="{Binding Mensaje}" Margin="0,10,0,0" FontSize="12" Foreground="#64748B"/>
            </StackPanel>
        </Border>

        <Border Grid.Row="1" Background="White" CornerRadius="14" BorderBrush="#E2E8F0" BorderThickness="1" ClipToBounds="True">
            <DataGrid ItemsSource="{Binding Operarios}" AutoGenerateColumns="False" IsReadOnly="True"
                      CanUserAddRows="False" HeadersVisibility="Column" BorderThickness="0"
                      GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#F1F5F9"
                      AlternatingRowBackground="#F8FAFC" RowBackground="White"
                      RowHeight="44" ColumnHeaderHeight="46" FontSize="13"
                      Foreground="#0F172A">
                <DataGrid.ColumnHeaderStyle>
                    <Style TargetType="DataGridColumnHeader">
                        <Setter Property="Background" Value="#F1F5F9"/>
                        <Setter Property="Foreground" Value="#1E293B"/>
                        <Setter Property="FontWeight" Value="SemiBold"/>
                        <Setter Property="FontSize" Value="12"/>
                        <Setter Property="Padding" Value="14,10"/>
                        <Setter Property="BorderBrush" Value="#E2E8F0"/>
                        <Setter Property="BorderThickness" Value="0,0,0,1"/>
                    </Style>
                </DataGrid.ColumnHeaderStyle>
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Nombres" Binding="{Binding Nombres}" Width="*"/>
                    <DataGridTextColumn Header="Apellidos" Binding="{Binding Apellidos}" Width="*"/>
                    <DataGridTextColumn Header="DNI" Binding="{Binding Dni}" Width="130"/>
                    <DataGridTextColumn Header="Fecha registro" Binding="{Binding FechaRegistro, StringFormat=dd/MM/yyyy}" Width="140"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>
    </Grid>
</UserControl>
