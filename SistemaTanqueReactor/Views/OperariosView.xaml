<UserControl x:Class="SistemaTanqueReactor.Views.OperariosView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes">

    <DockPanel>
        <Border DockPanel.Dock="Top" Style="{StaticResource ModernCard}" Margin="0,0,0,16">
            <StackPanel>
                <TextBlock Text="Registrar operario" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,16"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="140"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Nombres" Style="{StaticResource FieldLabel}"/>
                        <TextBox Text="{Binding Nombres}" Style="{StaticResource MaterialDesignOutlinedTextBox}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Apellidos" Style="{StaticResource FieldLabel}"/>
                        <TextBox Text="{Binding Apellidos}" Style="{StaticResource MaterialDesignOutlinedTextBox}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="4">
                        <TextBlock Text="DNI" Style="{StaticResource FieldLabel}"/>
                        <TextBox Text="{Binding Dni}" Style="{StaticResource MaterialDesignOutlinedTextBox}"/>
                    </StackPanel>
                    <Button Grid.Column="6" Style="{StaticResource PrimaryButton}" Command="{Binding GuardarCommand}"
                            Content="Guardar" VerticalAlignment="Bottom" Height="44" Width="120"/>
                </Grid>
                <TextBlock Text="{Binding Mensaje}" Margin="0,12,0,0" Foreground="{StaticResource TextSecondaryBrush}"/>
            </StackPanel>
        </Border>

        <Border Style="{StaticResource ModernCard}" Padding="0">
            <DataGrid ItemsSource="{Binding Operarios}" AutoGenerateColumns="False" IsReadOnly="True"
                      CanUserAddRows="False" HeadersVisibility="Column"
                      materialDesign:DataGridAssist.CellPadding="12,8">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Nombres" Binding="{Binding Nombres}" Width="*"/>
                    <DataGridTextColumn Header="Apellidos" Binding="{Binding Apellidos}" Width="*"/>
                    <DataGridTextColumn Header="DNI" Binding="{Binding Dni}" Width="120"/>
                    <DataGridTextColumn Header="Registro" Binding="{Binding FechaRegistro, StringFormat=dd/MM/yyyy}" Width="120"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>
    </DockPanel>
</UserControl>
