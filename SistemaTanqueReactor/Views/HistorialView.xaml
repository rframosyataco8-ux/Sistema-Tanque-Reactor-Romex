<UserControl x:Class="SistemaTanqueReactor.Views.HistorialView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes">

    <UserControl.Resources>
        <Style x:Key="DateOscuro" TargetType="DatePicker" BasedOn="{StaticResource MaterialDesignOutlinedDatePicker}">
            <Setter Property="Foreground" Value="#0F172A"/>
        </Style>
        <Style x:Key="ComboOscuro" TargetType="ComboBox" BasedOn="{StaticResource MaterialDesignOutlinedComboBox}">
            <Setter Property="Foreground" Value="#0F172A"/>
        </Style>
        <Style x:Key="InputOscuro" TargetType="TextBox" BasedOn="{StaticResource MaterialDesignOutlinedTextBox}">
            <Setter Property="Foreground" Value="#0F172A"/>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="White" CornerRadius="14" Padding="20" Margin="0,0,0,16"
                BorderBrush="#E2E8F0" BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="1.2*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="100"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="Desde" Style="{StaticResource FieldLabel}"/>
                    <DatePicker SelectedDate="{Binding FiltroDesde}" Style="{StaticResource DateOscuro}" Height="40"/>
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock Text="Hasta" Style="{StaticResource FieldLabel}"/>
                    <DatePicker SelectedDate="{Binding FiltroHasta}" Style="{StaticResource DateOscuro}" Height="40"/>
                </StackPanel>
                <StackPanel Grid.Column="4">
                    <TextBlock Text="Lote" Style="{StaticResource FieldLabel}"/>
                    <TextBox Text="{Binding FiltroLote, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource InputOscuro}" Height="40"
                             materialDesign:HintAssist.Hint="Buscar lote..."/>
                </StackPanel>
                <StackPanel Grid.Column="6">
                    <TextBlock Text="Turno" Style="{StaticResource FieldLabel}"/>
                    <ComboBox ItemsSource="{Binding TurnosFiltro}" SelectedItem="{Binding FiltroTurno}"
                              Style="{StaticResource ComboOscuro}" Height="40"/>
                </StackPanel>
                <StackPanel Grid.Column="8" Orientation="Horizontal" VerticalAlignment="Bottom">
                    <Button Style="{StaticResource PrimaryButton}" Command="{Binding BuscarCommand}"
                            Content="Buscar" Height="40" Padding="18,0" Margin="0,0,8,0"/>
                    <Button Style="{StaticResource OutlineButton}" Command="{Binding LimpiarFiltrosCommand}"
                            Content="Limpiar" Height="40" Margin="0,0,8,0"/>
                    <Button Style="{StaticResource PrimaryButton}" Command="{Binding ExportarExcelCommand}"
                            Content="Excel" Height="40" Padding="18,0" Background="#059669"/>
                </StackPanel>
            </Grid>
        </Border>

        <TextBlock Grid.Row="1" Text="{Binding Mensaje}" Margin="0,0,0,10"
                   Foreground="#64748B" FontSize="13"/>

        <Border Grid.Row="2" Background="White" CornerRadius="14" BorderBrush="#E2E8F0" BorderThickness="1" ClipToBounds="True">
            <DataGrid ItemsSource="{Binding Registros}" AutoGenerateColumns="False" IsReadOnly="True"
                      CanUserAddRows="False" HeadersVisibility="Column" BorderThickness="0"
                      GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#F1F5F9"
                      AlternatingRowBackground="#F8FAFC" RowBackground="White"
                      RowHeight="44" ColumnHeaderHeight="46" FontSize="13" Foreground="#0F172A">
                <DataGrid.ColumnHeaderStyle>
                    <Style TargetType="DataGridColumnHeader">
                        <Setter Property="Background" Value="#F1F5F9"/>
                        <Setter Property="Foreground" Value="#1E293B"/>
                        <Setter Property="FontWeight" Value="SemiBold"/>
                        <Setter Property="FontSize" Value="12"/>
                        <Setter Property="Padding" Value="14,10"/>
                        <Setter Property="BorderBrush" Value="#E2E8F0"/>
                        <Setter Property="BorderThickness" Value="0,0,0,1"/>
                    </Style>
                </DataGrid.ColumnHeaderStyle>
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Fecha" Binding="{Binding FechaProduccion, StringFormat=dd/MM/yyyy}" Width="110"/>
                    <DataGridTextColumn Header="Turno" Binding="{Binding Turno}" Width="70"/>
                    <DataGridTextColumn Header="Nº Lote" Binding="{Binding NumeroLote}" Width="140"/>
                    <DataGridTextColumn Header="Bolsas" Binding="{Binding CantidadBolsas}" Width="90"/>
                    <DataGridTextColumn Header="Kg" Binding="{Binding CantidadKg, StringFormat=N0}" Width="90"/>
                    <DataGridTextColumn Header="Expresión" Binding="{Binding ExpresionCantidad}" Width="*"/>
                    <DataGridTextColumn Header="Usuario" Binding="{Binding UsuarioRegistro}" Width="120"/>
                    <DataGridTextColumn Header="Registrado" Binding="{Binding FechaRegistro, StringFormat=dd/MM/yyyy HH:mm}" Width="140"/>
                    <DataGridTemplateColumn Header="Acciones" Width="100">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Button Content="Eliminar" Padding="10,4" Cursor="Hand"
                                        Background="#FEE2E2" Foreground="#B91C1C" BorderThickness="0"
                                        FontSize="12" FontWeight="SemiBold"
                                        Command="{Binding DataContext.EliminarCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                        CommandParameter="{Binding}"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Border>
    </Grid>
</UserControl>
