<UserControl x:Class="SistemaTanqueReactor.Views.HistorialView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes">

    <Grid Background="#F8FAFC">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Filtros -->
        <Border Grid.Row="0" Background="White" CornerRadius="16" Padding="20" Margin="0,0,0,16"
                BorderBrush="#E2E8F0" BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="14"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="14"/>
                    <ColumnDefinition Width="1.3*"/>
                    <ColumnDefinition Width="14"/>
                    <ColumnDefinition Width="110"/>
                    <ColumnDefinition Width="14"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="DESDE" Style="{StaticResource FieldLabel}"/>
                    <DatePicker SelectedDate="{Binding FiltroDesde}" Height="42"
                                Foreground="#0F172A" FontSize="14" FontWeight="Medium"
                                Background="White"/>
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock Text="HASTA" Style="{StaticResource FieldLabel}"/>
                    <DatePicker SelectedDate="{Binding FiltroHasta}" Height="42"
                                Foreground="#0F172A" FontSize="14" FontWeight="Medium"
                                Background="White"/>
                </StackPanel>
                <StackPanel Grid.Column="4">
                    <TextBlock Text="LOTE" Style="{StaticResource FieldLabel}"/>
                    <TextBox Text="{Binding FiltroLote, UpdateSourceTrigger=PropertyChanged}"
                             Height="42" Foreground="#0F172A" FontSize="14" FontWeight="Medium"
                             Background="White"
                             materialDesign:HintAssist.Hint="Nº de lote..."/>
                </StackPanel>
                <StackPanel Grid.Column="6">
                    <TextBlock Text="TURNO" Style="{StaticResource FieldLabel}"/>
                    <ComboBox ItemsSource="{Binding TurnosFiltro}" SelectedItem="{Binding FiltroTurno}"
                              Height="42" Foreground="#0F172A" FontSize="14" FontWeight="Medium"
                              Background="White"/>
                </StackPanel>
                <StackPanel Grid.Column="8" Orientation="Horizontal" VerticalAlignment="Bottom">
                    <Button Style="{StaticResource PrimaryButton}" Command="{Binding BuscarCommand}"
                            Content="Buscar" Margin="0,0,8,0"/>
                    <Button Style="{StaticResource OutlineButton}" Command="{Binding LimpiarFiltrosCommand}"
                            Content="Limpiar" Margin="0,0,8,0"/>
                    <Button Style="{StaticResource PrimaryButton}" Command="{Binding ExportarExcelCommand}"
                            Content="Excel" Background="#059669"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Contador -->
        <Border Grid.Row="1" Margin="0,0,0,12" Padding="4,0">
            <TextBlock Text="{Binding Mensaje}" FontSize="13" FontWeight="Medium" Foreground="#64748B"/>
        </Border>

        <!-- Tabla -->
        <Border Grid.Row="2" Background="White" CornerRadius="16" BorderBrush="#E2E8F0" BorderThickness="1" ClipToBounds="True">
            <DataGrid ItemsSource="{Binding Registros}" AutoGenerateColumns="False" IsReadOnly="True"
                      CanUserAddRows="False" HeadersVisibility="Column" BorderThickness="0"
                      GridLinesVisibility="None"
                      AlternatingRowBackground="#F8FAFC" RowBackground="White"
                      RowHeight="48" ColumnHeaderHeight="48" FontSize="13" Foreground="#0F172A"
                      SelectionUnit="FullRow">
                <DataGrid.ColumnHeaderStyle>
                    <Style TargetType="DataGridColumnHeader">
                        <Setter Property="Background" Value="#F1F5F9"/>
                        <Setter Property="Foreground" Value="#1E293B"/>
                        <Setter Property="FontWeight" Value="Bold"/>
                        <Setter Property="FontSize" Value="11"/>
                        <Setter Property="Padding" Value="16,12"/>
                        <Setter Property="BorderBrush" Value="#E2E8F0"/>
                        <Setter Property="BorderThickness" Value="0,0,0,1"/>
                        <Setter Property="HorizontalContentAlignment" Value="Left"/>
                    </Style>
                </DataGrid.ColumnHeaderStyle>
                <DataGrid.RowStyle>
                    <Style TargetType="DataGridRow">
                        <Setter Property="Background" Value="White"/>
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#F0FDFA"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Background" Value="#CCFBF1"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </DataGrid.RowStyle>
                <DataGrid.Columns>
                    <DataGridTextColumn Header="FECHA" Binding="{Binding FechaProduccion, StringFormat=dd/MM/yyyy}" Width="110"/>
                    <DataGridTextColumn Header="TURNO" Binding="{Binding Turno}" Width="70"/>
                    <DataGridTextColumn Header="Nº LOTE" Binding="{Binding NumeroLote}" Width="140"/>
                    <DataGridTextColumn Header="BOLSAS" Binding="{Binding CantidadBolsas}" Width="90"/>
                    <DataGridTextColumn Header="KG" Binding="{Binding CantidadKg, StringFormat=N0}" Width="90"/>
                    <DataGridTextColumn Header="EXPRESIÓN" Binding="{Binding ExpresionCantidad}" Width="*"/>
                    <DataGridTextColumn Header="USUARIO" Binding="{Binding UsuarioRegistro}" Width="120"/>
                    <DataGridTextColumn Header="REGISTRADO" Binding="{Binding FechaRegistro, StringFormat=dd/MM/yyyy HH:mm}" Width="150"/>
                    <DataGridTemplateColumn Header="" Width="100">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Button Content="Eliminar" Padding="12,6" Cursor="Hand"
                                        FontSize="12" FontWeight="SemiBold"
                                        Command="{Binding DataContext.EliminarCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                        CommandParameter="{Binding}">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="b" Background="#FEF2F2" CornerRadius="8" Padding="{TemplateBinding Padding}">
                                                <TextBlock Text="Eliminar" Foreground="#DC2626" FontWeight="SemiBold"
                                                           FontSize="12" HorizontalAlignment="Center"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="b" Property="Background" Value="#FEE2E2"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Border>
    </Grid>
</UserControl>
