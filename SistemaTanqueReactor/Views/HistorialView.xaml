<UserControl x:Class="SistemaTanqueReactor.Views.HistorialView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             Background="#0C0E14">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Style="{StaticResource ModernCard}" Padding="20" Margin="0,0,0,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="1.2*"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="100"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="DESDE" Style="{StaticResource FieldLabel}"/>
                    <DatePicker SelectedDate="{Binding FiltroDesde}" Height="42"/>
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock Text="HASTA" Style="{StaticResource FieldLabel}"/>
                    <DatePicker SelectedDate="{Binding FiltroHasta}" Height="42"/>
                </StackPanel>
                <StackPanel Grid.Column="4">
                    <TextBlock Text="LOTE" Style="{StaticResource FieldLabel}"/>
                    <TextBox Text="{Binding FiltroLote, UpdateSourceTrigger=PropertyChanged}" Height="42"
                             materialDesign:HintAssist.Hint="Nº lote..."/>
                </StackPanel>
                <StackPanel Grid.Column="6">
                    <TextBlock Text="TURNO" Style="{StaticResource FieldLabel}"/>
                    <ComboBox ItemsSource="{Binding TurnosFiltro}" SelectedItem="{Binding FiltroTurno}" Height="42"/>
                </StackPanel>
                <StackPanel Grid.Column="8" Orientation="Horizontal" VerticalAlignment="Bottom">
                    <Button Style="{StaticResource PrimaryButton}" Command="{Binding BuscarCommand}" Content="Buscar" Margin="0,0,8,0"/>
                    <Button Style="{StaticResource OutlineButton}" Command="{Binding LimpiarFiltrosCommand}" Content="Limpiar" Margin="0,0,8,0"/>
                    <Button Style="{StaticResource PrimaryButton}" Command="{Binding ExportarExcelCommand}" Content="Excel" Background="#A855F7"/>
                </StackPanel>
            </Grid>
        </Border>

        <TextBlock Grid.Row="1" Text="{Binding Mensaje}" Margin="0,0,0,12"
                   Foreground="#8B92A5" FontSize="12" FontWeight="SemiBold"/>

        <Border Grid.Row="2" Background="#1A1D27" CornerRadius="12" BorderBrush="#2A2E3A" BorderThickness="1" ClipToBounds="True">
            <DataGrid ItemsSource="{Binding Registros}" AutoGenerateColumns="False" IsReadOnly="True"
                      CanUserAddRows="False" HeadersVisibility="Column" BorderThickness="0"
                      GridLinesVisibility="None" Background="#1A1D27"
                      AlternatingRowBackground="#12141C" RowBackground="#1A1D27"
                      RowHeight="48" ColumnHeaderHeight="48" FontSize="13" Foreground="#F1F5F9">
                <DataGrid.ColumnHeaderStyle>
                    <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource DataGridHeaderGx}"/>
                </DataGrid.ColumnHeaderStyle>
                <DataGrid.Columns>
                    <DataGridTextColumn Header="FECHA" Binding="{Binding FechaProduccion, StringFormat=dd/MM/yyyy}" Width="110"/>
                    <DataGridTextColumn Header="TURNO" Binding="{Binding Turno}" Width="70"/>
                    <DataGridTextColumn Header="Nº LOTE" Binding="{Binding NumeroLote}" Width="140"/>
                    <DataGridTextColumn Header="BOLSAS" Binding="{Binding CantidadBolsas}" Width="90"/>
                    <DataGridTextColumn Header="KG" Binding="{Binding CantidadKg, StringFormat=N0}" Width="90"/>
                    <DataGridTextColumn Header="EXPRESIÓN" Binding="{Binding ExpresionCantidad}" Width="*"/>
                    <DataGridTextColumn Header="USUARIO" Binding="{Binding UsuarioRegistro}" Width="120"/>
                    <DataGridTextColumn Header="REGISTRADO" Binding="{Binding FechaRegistro, StringFormat=dd/MM/yyyy HH:mm}" Width="150"/>
                    <DataGridTemplateColumn Header="" Width="100">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Button Content="Eliminar" Padding="12,6" Cursor="Hand" FontSize="11" FontWeight="Bold"
                                        Command="{Binding DataContext.EliminarCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                        CommandParameter="{Binding}">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="#3A1528" CornerRadius="6" Padding="{TemplateBinding Padding}">
                                                <TextBlock Text="Eliminar" Foreground="#FF2D95" FontWeight="Bold" FontSize="11" HorizontalAlignment="Center"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Border>
    </Grid>
</UserControl>
