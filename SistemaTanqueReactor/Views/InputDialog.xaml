<Window x:Class="SistemaTanqueReactor.Views.InputDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Editar celda" Height="220" Width="420"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#12141C"
        FontFamily="Segoe UI">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock x:Name="TxtPrompt" TextWrapping="Wrap" Foreground="#F1F5F9" FontSize="13" Margin="0,0,0,16"/>

        <TextBox x:Name="TxtInput" Grid.Row="1" Height="40" FontSize="16" FontWeight="Bold"
                 Background="#1A1D27" Foreground="#00E5FF" CaretBrush="#00E5FF"
                 BorderBrush="#00E5FF" BorderThickness="1" Padding="10,8"
                 KeyDown="TxtInput_KeyDown"/>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button Content="Cancelar" Width="100" Height="36" Margin="0,0,10,0" Click="BtnCancel_Click"
                    Background="Transparent" Foreground="#8B92A5" BorderBrush="#2A2E3A" BorderThickness="1" Cursor="Hand"/>
            <Button Content="Aceptar" Width="100" Height="36" Click="BtnOk_Click"
                    Background="#00E5FF" Foreground="#0C0E14" FontWeight="Bold" BorderThickness="0" Cursor="Hand"/>
        </StackPanel>
    </Grid>
</Window>
